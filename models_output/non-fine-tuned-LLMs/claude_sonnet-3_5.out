process(sel) begin case sel is when "00" => y <= a; when "01" => y <= b; when "10" => y <= c; when others => y <= d; end case; end process;
process(Clk, Rst) begin if Rst = '1' then count <= (others => '0'); elsif rising_edge(Clk) and En = '1' then count <= count + 1; end if; end process;
process(sel, data_in) begin case sel is when "00" => data_out <= data_in; when "01" => data_out <= data_in(2 downto 0) & data_in(3); when "10" => data_out <= data_in(1 downto 0) & data_in(3 downto 2); when others => data_out <= data_in(0) & data_in(3 downto 1); end case; end process;
process(input) begin if input(3) = '1' then output <= "11"; elsif input(2) = '1' then output <= "10"; elsif input(1) = '1' then output <= "01"; elsif input(0) = '1' then output <= "00"; else output <= "00"; end if; end process;
process(BCD_value) variable temp : unsigned(N-1 downto 0) := (others => '0'); begin for i in 0 to N/4-1 loop temp := temp * 10 + unsigned(BCD_value(4i+3 downto 4i)); end loop; binary_value <= std_logic_vector(temp); end process;
process(clk, reset) begin if reset = '1' then count <= "00"; elsif rising_edge(clk) then count <= count + 1; end if; end process;
process(clk, trigger) begin if rising_edge(clk) then if trigger = '1' then pulse_out <= '1'; pulse_duration <= (others => '1'); elsif pulse_duration /= 0 then pulse_duration <= pulse_duration - 1; else pulse_out <= '0'; end if; end if; end process;
process(clk, reset) variable counter : unsigned(7 downto 0) := (others => '0'); begin if reset = '1' then pwm_out <= '0'; counter := (others => '0'); elsif rising_edge(clk) then if counter < duty_cycle then pwm_out <= '1'; else pwm_out <= '0'; end if; counter := counter + 1; end if; end process;
entity divider is port (dividend : in std_logic_vector(N-1 downto 0); divisor : in std_logic_vector(M-1 downto 0); quotient : out std_logic_vector(N-M downto 0); remainder : out std_logic_vector(M-1 downto 0)); end entity;
