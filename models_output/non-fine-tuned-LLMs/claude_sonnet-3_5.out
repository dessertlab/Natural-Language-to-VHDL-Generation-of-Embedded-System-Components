process(clk, reset) begin if reset = '1' then Johnson_count <= (others => '0'); elsif rising_edge(clk) then Johnson_count <= Johnson_count(N-2 downto 0) & not Johnson_count(N-1); end if; end process;
signal osc : std_logic_vector(2 downto 0) := "000"; osc <= not (osc(2) & osc(1) & osc(0));
process(clk) begin if rising_edge(clk) then if (input = '1' and count < MAX_COUNT) then count <= count + 1; elsif (input = '0') then count <= 0; end if; debounced <= '1' when count = MAX_COUNT else '0'; end if; end process;
process(clk) begin if rising_edge(clk) then prev_signal <= signal_in; rising_edge_detect <= signal_in and not prev_signal; end if; end process;
process(clock, reset) begin if reset = '1' then integrated_output <= (others => '0'); elsif rising_edge(clock) then integrated_output <= integrated_output + data_in; end if; end process;
process(clock, reset) begin if reset = '1' then LFSR_output <= seed_value; elsif rising_edge(clock) then LFSR_output <= LFSR_output(N-2 downto 0) & (LFSR_output(N-1) xor LFSR_output(N-2)); end if; end process;
process(clk) begin if rising_edge(clk) then if count = PULSE_WIDTH then pulse <= '0'; count <= 0; else pulse <= '1'; count <= count + 1; end if; end if; end process;
entity decoder_2to4 is port (A, B : in std_logic; D0, D1, D2, D3 : out std_logic); end entity;
process(clock) begin if rising_edge(clock) then random_number <= (random_number(N-2 downto 0) & (random_number(N-1) xor random_number(N-2))); end if; end process;
process(clk, reset) begin if reset = '1' then counter <= "0000"; elsif rising_edge(clk) then counter <= counter(2 downto 0) & not counter(3); end if; end process;
entity float_mult is port (A, B : in std_logic_vector(N-1 downto 0); product : out std_logic_vector(N-1 downto 0)); end entity;
process(clk) begin if rising_edge(clk) then if (noisy_in = '1' and count < FILTER_DEPTH) then count <= count + 1; elsif (noisy_in = '0') then count <= 0; end if; filtered_out <= '1' when count = FILTER_DEPTH else '0'; end if; end process;
entity crc_gen is port (data_in : in std_logic_vector(N-1 downto 0); crc_out : out std_logic_vector(M-1 downto 0)); end entity;
