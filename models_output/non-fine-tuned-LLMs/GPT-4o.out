library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity BCD_to_Binary is generic (N: integer := 16); port (BCD_value: in std_logic_vector((N/4)*4 - 1 downto 0); binary_value: out std_logic_vector(N - 1 downto 0)); end entity BCD_to_Binary; architecture Behavioral of BCD_to_Binary is begin process(BCD_value) variable binary_accum: unsigned(N - 1 downto 0) := (others => '0'); variable BCD_digit: unsigned(3 downto 0); begin binary_accum := (others => '0'); for i in 0 to (BCD_value'length/4 - 1) loop BCD_digit := unsigned(BCD_value(4*i + 3 downto 4*i)); binary_accum := binary_accum * 10 + BCD_digit; end loop; binary_value <= std_logic_vector(binary_accum); end process; end architecture Behavioral;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity binary_counter is port(clk, reset: in std_logic; count: out std_logic_vector(1 downto 0)); end entity; architecture Behavioral of binary_counter is signal count_reg: std_logic_vector(1 downto 0); begin process(clk, reset) begin if reset = '1' then count_reg <= "00"; elsif rising_edge(clk) then count_reg <= std_logic_vector(unsigned(count_reg) + 1); end if; end process; count <= count_reg; end architecture Behavioral;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity monostable_multivibrator is generic(N: integer := 8); port(trigger: in std_logic; pulse_out: out std_logic; pulse_duration: out std_logic_vector(N-1 downto 0)); end entity; architecture Behavioral of monostable_multivibrator is signal counter: unsigned(N-1 downto 0) := (others => '0'); signal pulse_active: std_logic := '0'; begin process(trigger) begin if rising_edge(trigger) then pulse_active <= '1'; counter <= (others => '0'); end if; end process; process(pulse_active) begin if pulse_active = '1' then if counter < (2**N-1) then counter <= counter + 1; else pulse_active <= '0'; end if; end if; end process; pulse_out <= pulse_active; pulse_duration <= std_logic_vector(counter); end architecture Behavioral;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity pwm_generator is port(clk: in std_logic; reset: in std_logic; duty_cycle: in std_logic_vector(7 downto 0); pwm_out: out std_logic); end entity; architecture Behavioral of pwm_generator is signal counter: unsigned(7 downto 0) := (others => '0'); begin process(clk, reset) begin if reset = '1' then counter <= (others => '0'); pwm_out <= '0'; elsif rising_edge(clk) then counter <= counter + 1; if counter < unsigned(duty_cycle) then pwm_out <= '1'; else pwm_out <= '0'; end if; end if; end process; end architecture Behavioral;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity divider is generic(N: integer; M: integer); port(dividend: in std_logic_vector(N-1 downto 0); divisor: in std_logic_vector(M-1 downto 0); quotient: out std_logic_vector(N-M downto 0); remainder: out std_logic_vector(M-1 downto 0)); end entity; architecture Behavioral of divider is signal dividend_u: unsigned(N-1 downto 0); signal divisor_u: unsigned(M-1 downto 0); signal quotient_u: unsigned(N-M downto 0); signal remainder_u: unsigned(M-1 downto 0); begin dividend_u <= unsigned(dividend); divisor_u <= unsigned(divisor); process(dividend_u, divisor_u) variable temp_dividend: unsigned(N-1 downto 0); variable temp_divisor: unsigned(N-1 downto 0); variable temp_quotient: unsigned(N-M downto 0); variable temp_remainder: unsigned(M-1 downto 0); begin temp_dividend := dividend_u; temp_divisor := divisor_u; temp_quotient := (others => '0'); temp_remainder := (others => '0'); for i in N-1 downto 0 loop temp_remainder := temp_remainder(M-2 downto 0) & temp_dividend(N-1); temp_dividend := temp_dividend(N-2 downto 0) & '0'; if temp_remainder >= temp_divisor then temp_remainder := temp_remainder - temp_divisor; temp_quotient := temp_quotient(N-M downto 0) & '1'; else temp_quotient := temp_quotient(N-M downto 0) & '0'; end if; end loop; quotient_u <= temp_quotient; remainder_u <= temp_remainder; end process; quotient <= std_logic_vector(quotient_u); remainder <= std_logic_vector(remainder_u); end architecture Behavioral;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity crc8 is port(clk: in std_logic; data_in: in std_logic_vector(7 downto 0); crc_out: out std_logic_vector(7 downto 0)); end entity; architecture Behavioral of crc8 is signal crc: std_logic_vector(7 downto 0) := (others => '0'); begin process(clk) begin if rising_edge(clk) then crc <= crc(6 downto 0) & data_in(7) xor crc(7); end if; end process; crc_out <= crc; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity fifo is generic (DEPTH: integer := 16; WIDTH: integer := 8); port(clk, rst: in std_logic; wr_en, rd_en: in std_logic; data_in: in std_logic_vector(WIDTH-1 downto 0); data_out: out std_logic_vector(WIDTH-1 downto 0); empty, full: out std_logic); end entity; architecture Behavioral of fifo is type fifo_array is array(0 to DEPTH-1) of std_logic_vector(WIDTH-1 downto 0); signal mem: fifo_array; signal wr_ptr, rd_ptr: integer range 0 to DEPTH-1 := 0; signal count: integer range 0 to DEPTH := 0; begin process(clk, rst) begin if rst = '1' then wr_ptr <= 0; rd_ptr <= 0; count <= 0; elsif rising_edge(clk) then if wr_en = '1' and not full then mem(wr_ptr) <= data_in; wr_ptr <= (wr_ptr + 1) mod DEPTH; count <= count + 1; end if; if rd_en = '1' and not empty then data_out <= mem(rd_ptr); rd_ptr <= (rd_ptr + 1) mod DEPTH; count <= count - 1; end if; end if; end process; empty <= '1' when count = 0 else '0'; full <= '1' when count = DEPTH else '0'; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity johnson_counter is generic(N: integer := 8); port(clk, reset: in std_logic; Johnson_count: out std_logic_vector(N-1 downto 0)); end entity; architecture Behavioral of johnson_counter is signal count: std_logic_vector(N-1 downto 0) := (others => '0'); begin process(clk, reset) begin if reset = '1' then count <= (others => '0'); elsif rising_edge(clk) then count <= count(N-2 downto 0) & not count(N-1); end if; end process; Johnson_count <= count; end architecture;
library ieee; use ieee.std_logic_1164.all; entity ring_oscillator is port(clk_out: out std_logic); end entity; architecture Behavioral of ring_oscillator is signal ring: std_logic_vector(4 downto 0) := "00001"; begin process begin wait for 1 ns; ring <= ring(3 downto 0) & not ring(4); end process; clk_out <= ring(4); end architecture;
library ieee; use ieee.std_logic_1164.all; entity debouncer is port(clk, rst, noisy: in std_logic; clean: out std_logic); end entity; architecture Behavioral of debouncer is signal shift_reg: std_logic_vector(2 downto 0); begin process(clk, rst) begin if rst = '1' then shift_reg <= (others => '0'); elsif rising_edge(clk) then shift_reg <= shift_reg(1 downto 0) & noisy; end if; end process; clean <= '1' when shift_reg = "111" else '0'; end architecture;
library ieee; use ieee.std_logic_1164.all; entity edge_detector is port(clk, signal_in: in std_logic; rising_edge_detected: out std_logic); end entity; architecture Behavioral of edge_detector is signal prev_signal: std_logic := '0'; begin process(clk) begin if rising_edge(clk) then if signal_in = '1' and prev_signal = '0' then rising_edge_detected <= '1'; else rising_edge_detected <= '0'; end if; prev_signal <= signal_in; end if; end process; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity digital_integrator is generic(N: integer := 16); port(clock, reset: in std_logic; data_in: in std_logic_vector(N-1 downto 0); integrated_output: out std_logic_vector(N-1 downto 0)); end entity; architecture Behavioral of digital_integrator is signal integrator: unsigned(N-1 downto 0) := (others => '0'); begin process(clock, reset) begin if reset = '1' then integrator <= (others => '0'); elsif rising_edge(clock) then integrator <= integrator + unsigned(data_in); end if; end process; integrated_output <= std_logic_vector(integrator); end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity lfsr is generic(N: integer := 16); port(clock, reset: in std_logic; seed_value: in std_logic_vector(N-1 downto 0); LFSR_output: out std_logic_vector(N-1 downto 0)); end entity; architecture Behavioral of lfsr is signal lfsr_reg: std_logic_vector(N-1 downto 0); begin process(clock, reset) begin if reset = '1' then lfsr_reg <= seed_value; elsif rising_edge(clock) then lfsr_reg <= lfsr_reg(N-2 downto 0) & (lfsr_reg(N-1) xor lfsr_reg(2) xor lfsr_reg(1) xor lfsr_reg(0)); end if; end process; LFSR_output <= lfsr_reg; end architecture;
library ieee; use ieee.std_logic_1164.all; entity pulse_generator is port(clk: in std_logic; pulse_out: out std_logic); end entity; architecture Behavioral of pulse_generator is signal pulse: std_logic := '0'; begin process(clk) begin if rising_edge(clk) then pulse <= not pulse; end if; end process; pulse_out <= pulse; end architecture;
library ieee; use ieee.std_logic_1164.all; entity decoder_2to4 is port(A, B: in std_logic; D0, D1, D2, D3: out std_logic); end entity; architecture Behavioral of decoder_2to4 is begin process(A, B) begin case (A & B) is when "00" => D0 <= '1'; D1 <= '0'; D2 <= '0'; D3 <= '0'; when "01" => D0 <= '0'; D1 <= '1'; D2 <= '0'; D3 <= '0'; when "10" => D0 <= '0'; D1 <= '0'; D2 <= '1'; D3 <= '0'; when "11" => D0 <= '0'; D1 <= '0'; D2 <= '0'; D3 <= '1'; when others => D0 <= '0'; D1 <= '0'; D2 <= '0'; D3 <= '0'; end case; end process; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity prng is generic(N: integer := 16); port(clock, reset: in std_logic; seed: in std_logic_vector(N-1 downto 0); random_number: out std_logic_vector(N-1 downto 0)); end entity; architecture Behavioral of prng is signal lfsr: std_logic_vector(N-1 downto 0); begin process(clock, reset) begin if reset = '1' then lfsr <= seed; elsif rising_edge(clock) then lfsr <= lfsr(N-2 downto 0) & (lfsr(N-1) xor lfsr(2) xor lfsr(1) xor lfsr(0)); end if; end process; random_number <= lfsr; end architecture;
library ieee; use ieee.std_logic_1164.all; entity johnson_counter is port(clk, reset: in std_logic; Johnson_count: out std_logic_vector(3 downto 0)); end entity; architecture Behavioral of johnson_counter is signal count: std_logic_vector(3 downto 0) := (others => '0'); begin process(clk, reset) begin if reset = '1' then count <= (others => '0'); elsif rising_edge(clk) then count <= count(2 downto 0) & not count(3); end if; end process; Johnson_count <= count; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity fp_multiplier is generic(N: integer := 32); port(A, B: in std_logic_vector(N-1 downto 0); product: out std_logic_vector(N-1 downto 0)); end entity; architecture Behavioral of fp_multiplier is signal A_float, B_float, product_float: ieee.float_pkg.real_vector(0 to 0); begin A_float(0) <= ieee.float_pkg.real(A); B_float(0) <= ieee.float_pkg.real(B); process(A_float, B_float) begin product_float(0) <= A_float(0) * B_float(0); end process; product <= std_logic_vector(product_float(0)); end architecture;
library ieee; use ieee.std_logic_1164.all; entity glitch_filter is port(noisy_in: in std_logic; filtered_out: out std_logic); end entity; architecture Behavioral of glitch_filter is signal filter: std_logic_vector(2 downto 0); begin process(noisy_in) begin filter <= filter(1 downto 0) & noisy_in; end process; filtered_out <= '1' when filter = "111" else '0'; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity crc_generator is generic(N: integer := 8); port(data_in: in std_logic_vector(N-1 downto 0); crc_out: out std_logic_vector(N-1 downto 0)); end entity; architecture Behavioral of crc_generator is signal crc: std_logic_vector(N-1 downto 0); begin process(data_in) variable crc_next: std_logic_vector(N-1 downto 0); begin crc_next := crc; for i in 0 to N-1 loop if crc_next(N-1) xor data_in(i) = '1' then crc_next := (crc_next(N-2 downto 0) & '0') xor "100000111"; else crc_next := crc_next(N-2 downto 0) & '0'; end if; end loop; crc <= crc_next; end process; crc_out <= crc; end architecture;
library ieee; use ieee.std_logic_1164.all; entity hamming_decoder is port(encoded: in std_logic_vector(6 downto 0); data_out: out std_logic_vector(3 downto 0); error_detected: out std_logic); end entity; architecture Behavioral of hamming_decoder is signal syndrome: std_logic_vector(2 downto 0); begin process(encoded) begin syndrome(0) <= encoded(6) xor encoded(4) xor encoded(2) xor encoded(0); syndrome(1) <= encoded(5) xor encoded(4) xor encoded(1) xor encoded(0); syndrome(2) <= encoded(3) xor encoded(2) xor encoded(1) xor encoded(0); case syndrome is when "000" => data_out <= encoded(6 downto 3); error_detected <= '0'; when others => data_out <= (others => '0'); error_detected <= '1'; end case; end process; end architecture;
library ieee; use ieee.std_logic_1164.all; entity parity_checker is port(D3, D2, D1, D0: in std_logic; even_parity, odd_parity: out std_logic); end entity; architecture Behavioral of parity_checker is begin process(D3, D2, D1, D0) begin even_parity <= D3 xor D2 xor D1 xor D0; odd_parity <= not even_parity; end process; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity counter_4bit is port(clk, reset: in std_logic; count: out std_logic_vector(3 downto 0)); end entity; architecture Behavioral of counter_4bit is signal count_reg: std_logic_vector(3 downto 0); begin process(clk) begin if rising_edge(clk) then if reset = '1' then count_reg <= (others => '0'); else count_reg <= std_logic_vector(unsigned(count_reg) + 1); end if; end if; end process; count <= count_reg; end architecture;
library ieee; use ieee.std_logic_1164.all; entity clock_gating is port(clk_in, enable: in std_logic; clk_out: out std_logic); end entity; architecture Behavioral of clock_gating is signal gated_clk: std_logic; begin gated_clk <= clk_in and enable; clk_out <= gated_clk; end architecture;
library ieee; use ieee.std_logic_1164.all; entity even_parity_checker is port(data: in std_logic_vector(7 downto 0); parity_bit: in std_logic; valid: out std_logic); end entity; architecture Behavioral of even_parity_checker is begin process(data, parity_bit) begin valid <= '1' when (parity_bit xor data(7) xor data(6) xor data(5) xor data(4) xor data(3) xor data(2) xor data(1) xor data(0)) = '0' else '0'; end process; end architecture;
