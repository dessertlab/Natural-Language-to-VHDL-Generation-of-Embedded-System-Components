library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity adder is generic(N: integer := 8); port(A, B: in std_logic_vector(N-1 downto 0); carry_in: in std_logic; sum: out std_logic_vector(N-1 downto 0); carry_out: out std_logic); end entity; architecture Behavioral of adder is begin process(A, B, carry_in) variable sum_int: unsigned(N downto 0); begin sum_int := unsigned(A) + unsigned(B) + unsigned(carry_in); sum <= std_logic_vector(sum_int(N-1 downto 0)); carry_out <= sum_int(N); end process; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity barrel_shifter is port(In3, In2, In1, In0: in std_logic; shift_left, shift_right: in std_logic; shift_amount: in unsigned(1 downto 0); Out3, Out2, Out1, Out0: out std_logic); end entity; architecture Behavioral of barrel_shifter is signal data: std_logic_vector(3 downto 0); begin data <= In3 & In2 & In1 & In0; process(data, shift_left, shift_right, shift_amount) begin if shift_left = '1' then data <= std_logic_vector(shift_left(data, to_integer(shift_amount))); elsif shift_right = '1' then data <= std_logic_vector(shift_right(data, to_integer(shift_amount))); end if; end process; Out3 <= data(3); Out2 <= data(2); Out1 <= data(1); Out0 <= data(0); end architecture;
