library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity uart_tx is port(clk, reset, tx_start: in std_logic; tx_data: in std_logic_vector(7 downto 0); tx_serial: out std_logic; tx_busy: out std_logic); end entity; architecture Behavioral of uart_tx is type state_type is (IDLE, START, DATA, STOP); signal state: state_type := IDLE; signal bit_count: integer range 0 to 7 := 0; signal tx_shift_reg: std_logic_vector(7 downto 0); begin process(clk, reset) begin if reset = '1' then state <= IDLE; tx_busy <= '0'; tx_serial <= '1'; elsif rising_edge(clk) then case state is when IDLE => if tx_start = '1' then tx_shift_reg <= tx_data; bit_count <= 0; tx_busy <= '1'; tx_serial <= '0'; state <= START; end if; when START => state <= DATA; when DATA => tx_serial <= tx_shift_reg(bit_count); bit_count <= bit_count + 1; if bit_count = 7 then state <= STOP; end if; when STOP => tx_serial <= '1'; tx_busy <= '0'; state <= IDLE; end case; end if; end process; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity pipo_shift_register is generic(N: integer := 8); port(clk: in std_logic; load_enable, shift_enable, shift_direction: in std_logic; data_in: in std_logic_vector(N-1 downto 0); data_out: out std_logic_vector(N-1 downto 0)); end entity; architecture Behavioral of pipo_shift_register is signal shift_reg: std_logic_vector(N-1 downto 0); begin process(clk) begin if rising_edge(clk) then if load_enable = '1' then shift_reg <= data_in; elsif shift_enable = '1' then if shift_direction = '1' then shift_reg <= shift_reg(N-2 downto 0) & '0'; else shift_reg <= '0' & shift_reg(N-1 downto 1); end if; end if; end if; end process; data_out <= shift_reg; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity parallel_to_serial is generic(N: integer := 8); port(clk: in std_logic; parallel_in: in std_logic_vector(N-1 downto 0); load_enable: in std_logic; serial_out: out std_logic); end entity; architecture Behavioral of parallel_to_serial is signal shift_reg: std_logic_vector(N-1 downto 0); signal bit_count: integer range 0 to N-1 := 0; begin process(clk) begin if rising_edge(clk) then if load_enable = '1' then shift_reg <= parallel_in; bit_count <= 0; else if bit_count < N then serial_out <= shift_reg(bit_count); bit_count <= bit_count + 1; end if; end if; end if; end process; end architecture;
