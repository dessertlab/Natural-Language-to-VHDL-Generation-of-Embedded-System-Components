library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity digital_clock is port(clk, reset: in std_logic; hours, minutes, seconds: out std_logic_vector(5 downto 0)); end entity; architecture Behavioral of digital_clock is signal sec, min, hr: unsigned(5 downto 0) := (others => '0'); signal clk_div: std_logic; begin process(clk, reset) begin if reset = '1' then sec <= (others => '0'); min <= (others => '0'); hr <= (others => '0'); elsif rising_edge(clk) then if clk_div = '1' then if sec = 59 then sec <= (others => '0'); if min = 59 then min <= (others => '0'); if hr = 23 then hr <= (others => '0'); else hr <= hr + 1; end if; else min <= min + 1; end if; else sec <= sec + 1; end if; end if; end if; end process; hours <= std_logic_vector(hr); minutes <= std_logic_vector(min); seconds <= std_logic_vector(sec); end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity clock_divider is generic(DIV_FACTOR: integer := 1000000); port(clk_in, reset: in std_logic; clk_out: out std_logic); end entity; architecture Behavioral of clock_divider is signal counter: integer := 0; signal clk_int: std_logic := '0'; begin process(clk_in, reset) begin if reset = '1' then counter <= 0; clk_int <= '0'; elsif rising_edge(clk_in) then if counter = DIV_FACTOR/2-1 then clk_int <= not clk_int; counter <= 0; else counter <= counter + 1; end if; end if; end process; clk_out <= clk_int; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity dual_clock_fifo is generic(DEPTH: integer := 16; WIDTH: integer := 8); port(clk_wr, clk_rd, reset: in std_logic; wr_en, rd_en: in std_logic; data_in: in std_logic_vector(WIDTH-1 downto 0); data_out: out std_logic_vector(WIDTH-1 downto 0); empty, full: out std_logic); end entity; architecture Behavioral of dual_clock_fifo is type fifo_array is array(0 to DEPTH-1) of std_logic_vector(WIDTH-1 downto 0); signal mem: fifo_array; signal wr_ptr, rd_ptr: integer range 0 to DEPTH-1 := 0; signal count: integer range 0 to DEPTH := 0; begin process(clk_wr, reset) begin if reset = '1' then wr_ptr <= 0; elsif rising_edge(clk_wr) then if wr_en = '1' and not full then mem(wr_ptr) <= data_in; wr_ptr <= (wr_ptr + 1) mod DEPTH; count <= count + 1; end if; end if; end process; process(clk_rd, reset) begin if reset = '1' then rd_ptr <= 0; elsif rising_edge(clk_rd) then if rd_en = '1' and not empty then data_out <= mem(rd_ptr); rd_ptr <= (rd_ptr + 1) mod DEPTH; count <= count - 1; end if; end if; end process; empty <= '1' when count = 0 else '0'; full <= '1' when count = DEPTH else '0'; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity barrel_shifter is generic(N: integer := 8); port(data_in: in std_logic_vector(N-1 downto 0); shift_left, shift_right: in std_logic; shift_amount: in unsigned(log2(N)-1 downto 0); data_out: out std_logic_vector(N-1 downto 0)); end entity; architecture Behavioral of barrel_shifter is begin process(data_in, shift_left, shift_right, shift_amount) begin if shift_left = '1' then data_out <= std_logic_vector(shift_left(unsigned(data_in), to_integer(shift_amount))); elsif shift_right = '1' then data_out <= std_logic_vector(shift_right(unsigned(data_in), to_integer(shift_amount))); else data_out <= data_in; end if; end process; end architecture;
library ieee; use ieee.std_logic_1164.all; entity johnson_counter is generic(N: integer := 8); port(clk, reset: in std_logic; Johnson_count: out std_logic_vector(N-1 downto 0)); end entity; architecture Behavioral of johnson_counter is signal count: std_logic_vector(N-1 downto 0) := (others => '0'); begin process(clk, reset) begin if reset = '1' then count <= (others => '0'); elsif rising_edge(clk) then count <= count(N-2 downto 0) & not count(N-1); end if; end process; Johnson_count <= count; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity uart_tx is port(clk, reset: in std_logic; tx_start: in std_logic; tx_data: in std_logic_vector(7 downto 0); tx_serial: out std_logic; tx_busy: out std_logic); end entity; architecture Behavioral of uart_tx is type state_type is (IDLE, START, DATA, STOP); signal state: state_type := IDLE; signal bit_count: integer range 0 to 7 := 0; signal tx_shift_reg: std_logic_vector(7 downto 0); begin process(clk, reset) begin if reset = '1' then state <= IDLE; tx_busy <= '0'; tx_serial <= '1'; elsif rising_edge(clk) then case state is when IDLE => if tx_start = '1' then tx_shift_reg <= tx_data; bit_count <= 0; tx_busy <= '1'; tx_serial <= '0'; state <= START; end if; when START => state <= DATA; when DATA => tx_serial <= tx_shift_reg(bit_count); bit_count <= bit_count + 1; if bit_count = 7 then state <= STOP; end if; when STOP => tx_serial <= '1'; tx_busy <= '0'; state <= IDLE; end case; end if; end process; end architecture;
library ieee; use ieee.std_logic_1164.all; use ieee.numeric_std.all; entity fifo_controller is generic(WIDTH: integer := 8; DEPTH: integer := 16); port(clk, reset: in std_logic; push, pop: in std_logic; data_in: in std_logic_vector(WIDTH-1 downto 0); data_out: out std_logic_vector(WIDTH-1 downto 0); empty, full: out std_logic); end entity; architecture Behavioral of fifo_controller is type fifo_type is array(0 to DEPTH-1) of std_logic_vector(WIDTH-1 downto 0); signal fifo: fifo_type; signal rd_ptr, wr_ptr: integer range 0 to DEPTH-1 := 0; signal fifo_count: integer range 0 to DEPTH := 0; begin process(clk, reset) begin if reset = '1' then rd_ptr <= 0; wr_ptr <= 0; fifo_count <= 0; elsif rising_edge(clk) then if push = '1' and not full then fifo(wr_ptr) <= data_in; wr_ptr <= (wr_ptr + 1) mod DEPTH; fifo_count <= fifo_count + 1; end if; if pop = '1' and not empty then data_out <= fifo(rd_ptr); rd_ptr <= (rd_ptr + 1) mod DEPTH; fifo_count <= fifo_count - 1; end if; end if; end process; empty <= '1' when fifo_count = 0 else '0'; full <= '1' when fifo_count = DEPTH else '0'; end architecture;
library ieee; use ieee.std_logic_1164.all; entity toggle_ff is port(clk, reset, toggle: in std_logic; q: out std_logic); end entity; architecture Behavioral of toggle_ff is signal q_int: std_logic := '0'; begin process(clk, reset) begin if reset = '1' then q_int <= '0'; elsif rising_edge(clk) then if toggle = '1' then q_int <= not q_int; end if; end if; end process; q <= q_int; end architecture;
library ieee; use ieee.std_logic_1164.all; entity bcd_to_7seg is port(bcd_in: in std_logic_vector(3 downto 0); seg_out: out std_logic_vector(6 downto 0)); end entity; architecture Behavioral of bcd_to_7seg is begin process(bcd_in) begin case bcd_in is when "0000" => seg_out <= "0000001"; -- 0 when "0001" => seg_out <= "1001111"; -- 1 when "0010" => seg_out <= "0010010"; -- 2 when "0011" => seg_out <= "0000110"; -- 3 when "0100" => seg_out <= "1001100"; -- 4 when "0101" => seg_out <= "0100100"; -- 5 when "0110" => seg_out <= "0100000"; -- 6 when "0111" => seg_out <= "0001111"; -- 7 when "1000" => seg_out <= "0000000"; -- 8 when "1001" => seg_out <= "0000100"; -- 9 when others => seg_out <= "1111111"; -- Error end case; end process; end architecture;
