architecture behavioral of counter is begin process (Clk, Rst) variable count_temp : unsigned(N-1 downto 0) := (others => '0'); begin if Rst = '1' then count_temp := (others => '0'); elsif rising_edge(Clk) and En = '1' then count_temp := count_temp + 1; end if; count <= std_logic_vector(count_temp); end process; end behavioral;
architecture behavioral of barrel_shifter is begin process(clk) variable temp : std_logic_vector(3 downto 0) := "0000"; begin if(clk'event and clk = '1') then temp := temp srl 1; end if; end process; end behavioral;
architecture behavioral of priority_encoder is begin process(input_vector) variable highest_bit : integer := 0; begin for i in input_vector'range loop if(input_vector(i) = '1') then highest_bit <= i; end if; end loop; output <= std_logic_vector(to_unsigned(highest_bit, output'length)); end process; end behavioral;
architecture bcd_to_binary of bcd_converter is begin process(BCD_value) variable temp : unsigned(3 downto 0) := (others => '0'); variable binary : unsigned(N-1 downto 0) := (others => '0'); begin temp(3 downto 0) := BCD_value; binary(N-1 downto 0) <= to_unsigned(temp(3) * 1000 + temp(2) * 100 + temp(1) * 10 + temp(0) * 1, N); end process; end bcd_to_binary;
architecture behavioral of binary_counter is begin process(clk) variable count : unsigned(1 downto 0) := (others => '0'); begin if(rising_edge(clk)) then count := count + 1; end if; end process; end behavioral;
architecture monostable of multivibrator is begin process(trigger) variable pulse : std_logic := '0'; begin if(trigger'event and trigger = '1') then pulse := '1'; pulse_out <= '1'; wait for pulse_duration * 1 ns; pulse := '0'; pulse_out <= '0'; end if; end process; end monostable;
architecture pwm_generator of pwm is begin process(clk) variable duty : unsigned(N-1 downto 0) := (others => '0'); begin if(rising_edge(clk)) then duty := duty + 1; if(duty = duty_cycle) then pwm_out <= '1'; elsif(duty = duty_max) then pwm_out <= '0'; end if; end if; end process; end pwm_generator;
architecture divider of divide_nm is begin process(dividend, divisor) variable quotient_temp : unsigned(N-M+1-1 downto 0) := (others => '0'); variable remainder_temp : unsigned(M-1 downto 0) := (others => '0'); begin quotient_temp := dividend / divisor; remainder_temp := dividend mod divisor; quotient <= std_logic_vector(quotient_temp); remainder <= std_logic_vector(remainder_temp); end process; end divider;
architecture crc_8 of crc_calculator is begin process(data_in) variable crc_value : unsigned(7 downto 0) := (others => '0'); begin for i in data_in'range loop if(crc_table(to_integer(unsigned(data_in(i)))) = '1') then crc_value := crc_value xor crc_poly; end if; end loop; crc_out <= std_logic_vector(crc_value); end process; end crc_8;
architecture fifo of buffer is begin process(clk) type fifo_array is array(0 to FIFO_DEPTH-1) of std_logic_vector(DATA_WIDTH-1 downto 0); variable fifo_mem : fifo_array := (others => (others => '0')); variable wr_ptr, rd_ptr : integer := 0; begin if(rising_edge(clk)) then if(write_enable = '1') then fifo_mem(wr_ptr) := data_in; wr_ptr := wr_ptr + 1; elsif(read_enable = '1') then data_out <= fifo_mem(rd_ptr); rd_ptr := rd_ptr + 1; end if; end if; end process; end fifo;
architecture johnson_ring of ring_counter is begin process(clk, reset) variable count_temp : unsigned(N-1 downto 0) := (others => '0'); begin if(reset = '1') then count_temp := (others => '0'); elsif(rising_edge(clk)) then count_temp := count_temp(N-2 downto 0) & count_temp(N-1); end if; Johnson_count <= std_logic_vector(count_temp); end process; end johnson_ring;
architecture ring_oscillator of oscillator is begin process begin clk <= '0'; wait for CLK_PERIOD / 2; clk <= '1'; wait for CLK_PERIOD / 2; end process; end ring_oscillator;
architecture debouncer of input_signal is begin process(noisy_input) variable stable_signal : std_logic := '0'; variable debounce_cnt : integer := 0; begin if(noisy_input /= stable_signal) then debounce_cnt := debounce_cnt + 1; elsif(debounce_cnt >= DEBOUNCE_THRESHOLD) then stable_signal := noisy_input; debounce_cnt := 0; end if; output <= stable_signal; end process; end debouncer;
architecture rising_edge_detector of edge_detector is begin process(clock) variable rising_edge_detected : std_logic := '0'; begin if(rising_edge(clock)) then if(signal'event and signal = '1') then rising_edge_detected <= '1'; elsif(rising_edge_detected = '1') then rising_edge_detected <= '0'; end if; end if; end process; end rising_edge_detector;
architecture integrator of digital_integrator is begin process(clock, reset) variable integrated_value : signed(N-1 downto 0) := (others => '0'); begin if(reset = '1') then integrated_value := (others => '0'); elsif(rising_edge(clock)) then integrated_value <= integrated_value + resize(signed(data_in), integrated_value'length); end if; integrated_output <= std_logic_vector(integrated_value); end process; end integrator;
architecture lfsr of shift_register is begin process(clock, reset) variable lfsr_value : unsigned(N-1 downto 0) := (others => '0'); begin if(reset = '1') then lfsr_value := to_unsigned(seed_value, N); elsif(rising_edge(clock)) then lfsr_value(N-1 downto 1) := lfsr_value(N-2 downto 0); lfsr_value(0) := lfsr_value(N-1) xor lfsr_value(N-3); end if; LFSR_output <= std_logic_vector(lfsr_value); end process; end lfsr;
architecture pulse_generator of generator is begin process begin wait for PULSE_DURATION; pulse <= '1'; wait for PULSE_DURATION; pulse <= '0'; end process; end pulse_generator;
architecture decoder_2_4 of decoder is begin process(A, B) begin case A & B is when "00" => D0 <= '1'; D1 <= '0'; D2 <= '0'; D3 <= '0'; when "01" => D0 <= '0'; D1 <= '1'; D2 <= '0'; D3 <= '0'; when "10" => D0 <= '0'; D1 <= '0'; D2 <= '1'; D3 <= '0'; when "11" => D0 <= '0'; D1 <= '0'; D2 <= '0'; D3 <= '1'; end case; end process; end decoder_2_4;
architecture prng of pseudo_random_generator is begin process(clock) variable random_value : unsigned(N-1 downto 0) := to_unsigned(seed, N); begin if(rising_edge(clock)) then random_value := (random_value * 7) + (random_value * 13) + (random_value * 21); random_number <= std_logic_vector(random_value); end if; end process; end prng;
architecture johnson_counter of counter is begin process(clk, reset) variable count_temp : unsigned(3 downto 0) := "0000"; begin if(reset = '1') then count_temp := "0000"; elsif(rising_edge(clk)) then count_temp := count_temp(2 downto 0) & count_temp(3); end if; johnson_count <= std_logic_vector(count_temp); end process; end johnson_counter;
architecture floating_point_multiplier of multiplier is begin process(A, B) variable product_temp : signed(2*N-1 downto 0) := (others => '0'); begin product_temp := resize(signed(A), N) * resize(signed(B), N); product <= std_logic_vector(product_temp(N-1 downto 0)); end process; end floating_point_multiplier;
architecture glitch_filter of filter is begin process(noisy_in) variable filtered_signal : std_logic := '0'; variable filter_cnt : integer := 0; begin if(noisy_in /= filtered_signal) then filter_cnt := filter_cnt + 1; elsif(filter_cnt >= FILTER_THRESHOLD) then filtered_signal := noisy_in; filter_cnt := 0; end if; filtered_out <= filtered_signal; end process; end glitch_filter;
architecture crc_generator of crc is begin process(parallel_input) variable crc_value : unsigned(CRC_WIDTH-1 downto 0) := (others => '0'); begin for i in parallel_input'range loop if(crc_table(to_integer(unsigned(parallel_input(i)))) = '1') then crc_value := crc_value xor crc_poly; end if; end loop; crc_out <= std_logic_vector(crc_value); end process; end crc_generator;
architecture hamming_decoder of decoder is begin process(encoded) variable syndrome : unsigned(2 downto 0) := (others => '0'); variable data_temp : unsigned(3 downto 0) := (others => '0'); begin syndrome(2) <= encoded(6) xor encoded(5) xor encoded(4) xor encoded(1); syndrome(1) <= encoded(6) xor encoded(3) xor encoded(2) xor encoded(0); syndrome(0) <= encoded(6) xor encoded(5) xor encoded(3) xor encoded(1); data_temp(3) <= encoded(6) xor encoded(5) xor encoded(2); data_temp(2) <= encoded(5) xor encoded(4); data_temp(1) <= encoded(3) xor encoded(1); data_temp(0) <= encoded(6) xor encoded(0); data_out <= std_logic_vector(data_temp); error_detected <= '1' when syndrome /= "000" else '0'; end process; end hamming_decoder;
architecture parity_checker of checker is begin process(D3, D2, D1, D0) begin even_parity <= D3 xor D1 xor D0; odd_parity <= D3 xor D2 xor D1 xor D0; end process; end parity_checker;
architecture counter_with_sync_reset of counter is begin process(clk, reset) variable count_temp : unsigned(3 downto 0) := (others => '0'); begin if(reset = '1') then count_temp := (others => '0'); elsif(rising_edge(clk)) then count_temp := count_temp + 1; end if; count <= std_logic_vector(count_temp); end process; end counter_with_sync_reset;
architecture clock_gating of gating_circuit is begin process(enable, clock) begin if(enable = '1') then gated_clock <= clock; else gated_clock <= '0'; end if; end process; end clock_gating;
architecture parity_checker of checker is begin process(D7 downto D0) variable parity_value : std_logic := '0'; begin for i in D7 downto D0'range loop parity_value := parity_value xor D(i); end loop; even_parity <= parity_value; end process; end parity_checker;
architecture edge_detector of detector is begin process(signal_in) begin if(rising_edge(signal_in)) then rising_edge <= '1'; elsif(falling_edge(signal_in)) then falling_edge <= '1'; end if; if(rising_edge = '1' or falling_edge = '1') then rising_edge <= '0'; falling_edge <= '0'; end if; end process; end edge_detector;
architecture excess3_to_bcd of converter is begin process(excess3_value) variable bcd_temp : unsigned(3 downto 0) := (others => '0'); begin case excess3_value is when "0000" => bcd_temp <= "0000"; when "0001" => bcd_temp <= "0001"; when "0010" => bcd_temp <= "0010"; when "0011" => bcd_temp <= "0100"; when "0100" => bcd_temp <= "0001"; when "0101" => bcd_temp <= "0101"; when "0110" => bcd_temp <= "1001"; when "0111" => bcd_temp <= "0011"; when "1000" => bcd_temp <= "1001"; when "1001" => bcd_temp <= "0110"; when "1010" => bcd_temp <= "0010"; when "1011" => bcd_temp <= "0111"; when "1100" => bcd_temp <= "1001"; when "1101" => bcd_temp <= "0101"; when "1110" => bcd_temp <= "1011"; when "1111" => bcd_temp <= "0110"; end case; end process; end excess3_to_bcd;
architecture multiplier_with_process of multiplier is begin process(A, B) variable product_temp : unsigned(7 downto 0) := (others => '0'); begin for i in 0 to 3 loop if(A(i) = '1') then product_temp := product_temp + shift_left(unsigned(B), i); end if; end loop; product <= std_logic_vector(product_temp); end process; end multiplier_with_process;
architecture gated_d_latch of latch is begin process(enable, D, clock) begin if(rising_edge(clock) and enable = '1') then Q <= D; end if; end process; end gated_d_latch;
architecture lfsr_with_taps of lfsr is begin process(clk, reset) variable lfsr_value : unsigned(N-1 downto 0) := (others => '0'); variable taps : unsigned(N-1 downto 0) := (others => '0'); begin if(reset = '1') then lfsr_value := (others => '0'); elsif(rising_edge(clk)) then taps := lfsr_value; for i in taps'range loop if(taps(i) = '1') then lfsr_value(N-1 downto i+1) := lfsr_value(N-2 downto i); end if; end loop; lfsr_value(0) := lfsr_value(taps'high); end if; LFSR_output <= std_logic_vector(lfsr_value); end process; end lfsr_with_taps;
architecture bidirectional_shift_register of register is begin process(clk, clear, ser_in, shift_en, shift_dir) variable shift_value : std_logic_vector(P-1 downto 0) := (others => '0'); begin if(clear = '1') then shift_value := (others => '0'); elsif(rising_edge(clk)) then if(shift_en = '1' and shift_dir = '0') then shift_value(P-2 downto 0) := shift_value(P-1 downto 1); shift_value(P-1) <= ser_in; elsif(shift_en = '1' and shift_dir = '1') then shift_value(1 to P-1) := shift_value(0 to P-2); shift_value(0) <= ser_in; end if; end if; par_out <= shift_value; ser_out <= shift_value(0); end process; end bidirectional_shift_register;
architecture parity_checker_4bit of checker is begin process(D3, D2, D1, D0) begin even <= D3 xor D1 xor D0; odd <= D3 xor D2 xor D1 xor D0; end process; end parity_checker_4bit;
architecture adder_n_bit of adder is begin process(A, B, carry_in) variable sum_temp : unsigned(N-1 downto 0) := (others => '0'); begin sum_temp := resize(unsigned(A), N) + resize(unsigned(B), N) + to_unsigned(carry_in, 1); sum <= std_logic_vector(sum_temp); carry_out <= sum_temp(N-1); end process; end adder_n_bit;
architecture barrel_shifter_4bit of shifter is begin process(In3, In2, In1, In0, shift_left, shift_right, shift_amount) variable shifted_value : std_logic_vector(3 downto 0) := "0000"; begin if(shift_left = '1') then shifted_value := shift_left(unsigned(In3 & In2 & In1 & In0), to_integer(unsigned(shift_amount))); elsif(shift_right = '1') then shifted_value := shift_right(unsigned(In3 & In2 & In1 & In0), to_integer(unsigned(shift_amount))); end if; Out3 <= shifted_value(3); Out2 <= shifted_value(2); Out1 <= shifted_value(1); Out0 <= shifted_value(0); end process; end barrel_shifter_4bit;
architecture glitch_filter of filter is begin process(noisy_signal) variable filtered_signal : std_logic := '0'; variable filter_cnt : integer := 0; begin if(noisy_signal /= filtered_signal) then filter_cnt := filter_cnt + 1; elsif(filter_cnt >= FILTER_THRESHOLD) then filtered_signal := noisy_signal; filter_cnt := 0; end if; filtered_signal <= noisy_signal; end process; end glitch_filter;
architecture digital_clock of clock is begin process(clk) variable hours, minutes, seconds : unsigned(N-1 downto 0) := (others => '0'); begin if(rising_edge(clk)) then seconds <= seconds + 1; if(seconds = 59) then seconds <= (others => '0'); minutes <= minutes + 1; if(minutes = 59) then minutes <= (others => '0'); hours <= hours + 1; end if; end if; end if; end process; end digital_clock;
architecture clock_divider of divider is begin process(clk) variable clk_divided : unsigned(N-1 downto 0) := (others => '0'); begin if(rising_edge(clk)) then clk_divided <= clk_divided + 1; if(clk_divided = DIVIDER_VALUE-1) then clk_divided <= (others => '0'); clk_out <= not clk_out; end if; end if; end process; end clock_divider;
architecture dual_clock_fifo of fifo is begin process(clk_write, clk_read) type fifo_array is array(0 to FIFO_DEPTH-1) of std_logic_vector(DATA_WIDTH-1 downto 0); variable fifo_mem : fifo_array := (others => (others => '0')); variable wr_ptr, rd_ptr : integer := 0; begin if(rising_edge(clk_write)) then if(write_enable = '1') then fifo_mem(wr_ptr) <= data_in; wr_ptr <= wr_ptr + 1; end if; elsif(rising_edge(clk_read)) then if(read_enable = '1') then data_out <= fifo_mem(rd_ptr); rd_ptr <= rd_ptr + 1; end if; end if; end process; end dual_clock_fifo;
architecture barrel_shifter_n_bit of shifter is begin process(data_in, shift_left, shift_right, shift_amount) variable shifted_value : unsigned(N-1 downto 0) := (others => '0'); begin if(shift_left = '1') then shifted_value := shift_left(unsigned(data_in), to_integer(unsigned(shift_amount))); elsif(shift_right = '1') then shifted_value := shift_right(unsigned(data_in), to_integer(unsigned(shift_amount))); end if; data_out <= std_logic_vector(shifted_value); end process; end barrel_shifter_n_bit;
