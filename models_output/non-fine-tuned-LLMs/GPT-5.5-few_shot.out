library ieee;\nuse ieee.std_logic_1164.all;\n\nentity GlitchFilter is\n    port (\n        noisy_in : in std_logic;\n        filtered_out : out std_logic\n    );\nend GlitchFilter;\n\narchitecture Behavioral of GlitchFilter is\nbegin\n    filtered_out <= noisy_in after 10 ns;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity MovingAverageFilter is\n    generic (\n        DATA_WIDTH  : positive := 16;\n        WINDOW_SIZE : positive := 8\n    );\n    port (\n        clk       : in  std_logic;\n        rst       : in  std_logic;\n        valid_in  : in  std_logic;\n        data_in   : in  std_logic_vector(DATA_WIDTH - 1 downto 0);\n        valid_out : out std_logic;\n        data_out  : out std_logic_vector(DATA_WIDTH - 1 downto 0)\n    );\nend MovingAverageFilter;\n\narchitecture Behavioral of MovingAverageFilter is\n    function clog2(n : positive) return natural is\n        variable value  : natural := n - 1;\n        variable result : natural := 0;\n    begin\n        while value > 0 loop\n            value  := value / 2;\n            result := result + 1;\n        end loop;\n        return result;\n    end function;\n\n    constant SUM_WIDTH : natural := DATA_WIDTH + clog2(WINDOW_SIZE);\n\n    type sample_buffer_t is array (0 to WINDOW_SIZE - 1) of unsigned(DATA_WIDTH - 1 downto 0);\n\n    signal sample_buffer : sample_buffer_t := (others => (others => '0'));\n    signal write_ptr     : natural range 0 to WINDOW_SIZE - 1 := 0;\n    signal sum           : unsigned(SUM_WIDTH - 1 downto 0) := (others => '0');\nbegin\n    process(clk)\n        variable new_sample : unsigned(DATA_WIDTH - 1 downto 0);\n        variable old_sample : unsigned(DATA_WIDTH - 1 downto 0);\n        variable new_sum    : unsigned(SUM_WIDTH - 1 downto 0);\n        variable average    : unsigned(SUM_WIDTH - 1 downto 0);\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                sample_buffer <= (others => (others => '0'));\n                write_ptr     <= 0;\n                sum           <= (others => '0');\n                data_out      <= (others => '0');\n                valid_out     <= '0';\n            else\n                valid_out <= '0';\n\n                if valid_in = '1' then\n                    new_sample := unsigned(data_in);\n                    old_sample := sample_buffer(write_ptr);\n                    new_sum    := sum + resize(new_sample, SUM_WIDTH) - resize(old_sample, SUM_WIDTH);\n                    average    := new_sum / WINDOW_SIZE;\n\n                    sample_buffer(write_ptr) <= new_sample;\n                    sum <= new_sum;\n                    data_out <= std_logic_vector(resize(average, DATA_WIDTH));\n                    valid_out <= '1';\n\n                    if write_ptr = WINDOW_SIZE - 1 then\n                        write_ptr <= 0;\n                    else\n                        write_ptr <= write_ptr + 1;\n                    end if;\n                end if;\n            end if;\n        end if;\n    end process;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity ManchesterDecoder is\n    port (\n        clk : in std_logic;\n        rst : in std_logic;\n        manchester_in : in std_logic;\n        data_out : out std_logic;\n        valid : out std_logic;\n        error : out std_logic\n    );\nend ManchesterDecoder;\n\narchitecture Behavioral of ManchesterDecoder is\n    signal first_half : std_logic := '0';\n    signal phase : std_logic := '0';\nbegin\n    process(clk, rst)\n    begin\n        if rst = '1' then\n            first_half <= '0';\n            phase <= '0';\n            data_out <= '0';\n            valid <= '0';\n            error <= '0';\n        elsif rising_edge(clk) then\n            valid <= '0';\n            error <= '0';\n\n            if phase = '0' then\n                first_half <= manchester_in;\n                phase <= '1';\n            else\n                phase <= '0';\n\n                if first_half = '0' and manchester_in = '1' then\n                    data_out <= '1';\n                    valid <= '1';\n                elsif first_half = '1' and manchester_in = '0' then\n                    data_out <= '0';\n                    valid <= '1';\n                else\n                    error <= '1';\n                end if;\n            end if;\n        end if;\n    end process;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity N_bit_register is\n    generic (\n        N : integer := 8\n    );\n    port (\n        clock  : in  std_logic;\n        reset  : in  std_logic;\n        enable : in  std_logic;\n        D      : in  std_logic_vector(N-1 downto 0);\n        Q      : out std_logic_vector(N-1 downto 0)\n    );\nend N_bit_register;\n\narchitecture Behavioral of N_bit_register is\nbegin\n    process(clock, reset)\n    begin\n        if reset = '1' then\n            Q <= (others => '0');\n        elsif rising_edge(clock) then\n            if enable = '1' then\n                Q <= D;\n            end if;\n        end if;\n    end process;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity comparator_4bit is\n    port (\n        a  : in  std_logic_vector(3 downto 0);\n        b  : in  std_logic_vector(3 downto 0);\n        eq : out std_logic;\n        gt : out std_logic;\n        lt : out std_logic\n    );\nend comparator_4bit;\n\narchitecture behavioral of comparator_4bit is\nbegin\n    eq <= '1' when a = b else '0';\n    gt <= '1' when unsigned(a) > unsigned(b) else '0';\n    lt <= '1' when unsigned(a) < unsigned(b) else '0';\nend behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity spi_slave is\n    port (\n        clk        : in  std_logic;\n        rst        : in  std_logic;\n        sclk       : in  std_logic;\n        ss_n       : in  std_logic;\n        mosi       : in  std_logic;\n        miso       : out std_logic;\n        data_in    : in  std_logic_vector(7 downto 0);\n        data_out   : out std_logic_vector(7 downto 0);\n        data_valid : out std_logic\n    );\nend spi_slave;\n\narchitecture rtl of spi_slave is\n    signal sclk_d    : std_logic := '0';\n    signal shift_in  : std_logic_vector(7 downto 0) := (others => '0');\n    signal shift_out : std_logic_vector(7 downto 0) := (others => '0');\n    signal bit_count : integer range 0 to 7 := 0;\n    signal miso_reg  : std_logic := '0';\nbegin\n    miso <= miso_reg;\n\n    process (clk, rst)\n    begin\n        if rst = '1' then\n            sclk_d     <= '0';\n            shift_in   <= (others => '0');\n            shift_out  <= (others => '0');\n            bit_count  <= 0;\n            data_out   <= (others => '0');\n            data_valid <= '0';\n            miso_reg   <= '0';\n        elsif rising_edge(clk) then\n            sclk_d     <= sclk;\n            data_valid <= '0';\n\n            if ss_n = '1' then\n                bit_count <= 0;\n                shift_out <= data_in;\n                miso_reg  <= data_in(7);\n            else\n                if sclk_d = '0' and sclk = '1' then\n                    shift_in <= shift_in(6 downto 0) & mosi;\n\n                    if bit_count = 7 then\n                        data_out   <= shift_in(6 downto 0) & mosi;\n                        data_valid <= '1';\n                        bit_count  <= 0;\n                        shift_out  <= data_in;\n                        miso_reg   <= data_in(7);\n                    else\n                        bit_count <= bit_count + 1;\n                        shift_out <= shift_out(6 downto 0) & '0';\n                        miso_reg  <= shift_out(6);\n                    end if;\n                end if;\n            end if;\n        end if;\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity frequency_counter is\n    generic (\n        GATE_CYCLES : positive := 100000000;\n        COUNTER_WIDTH : positive := 32\n    );\n    port (\n        clk : in std_logic;\n        rst : in std_logic;\n        signal_in : in std_logic;\n        frequency : out std_logic_vector(COUNTER_WIDTH - 1 downto 0)\n    );\nend frequency_counter;\n\narchitecture rtl of frequency_counter is\n    signal gate_counter : natural range 0 to GATE_CYCLES - 1 := 0;\n    signal pulse_counter : unsigned(COUNTER_WIDTH - 1 downto 0) := (others => '0');\n    signal signal_in_d : std_logic := '0';\nbegin\n    process(clk, rst)\n        variable next_pulse_count : unsigned(COUNTER_WIDTH - 1 downto 0);\n    begin\n        if rst = '1' then\n            gate_counter <= 0;\n            pulse_counter <= (others => '0');\n            signal_in_d <= '0';\n            frequency <= (others => '0');\n        elsif rising_edge(clk) then\n            next_pulse_count := pulse_counter;\n\n            if signal_in = '1' and signal_in_d = '0' then\n                next_pulse_count := pulse_counter + 1;\n            end if;\n\n            signal_in_d <= signal_in;\n\n            if gate_counter = GATE_CYCLES - 1 then\n                frequency <= std_logic_vector(next_pulse_count);\n                pulse_counter <= (others => '0');\n                gate_counter <= 0;\n            else\n                pulse_counter <= next_pulse_count;\n                gate_counter <= gate_counter + 1;\n            end if;\n        end if;\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity parallel_to_serial is\n    generic (N : positive := 8);\n    port (\n        clk : in std_logic;\n        parallel_in : in std_logic_vector(N-1 downto 0);\n        load_en : in std_logic;\n        serial_out : out std_logic\n    );\nend parallel_to_serial;\n\narchitecture rtl of parallel_to_serial is\n    signal shift_reg : std_logic_vector(N-1 downto 0);\nbegin\n    process(clk)\n    begin\n        if rising_edge(clk) then\n            if load_en = '1' then\n                shift_reg <= parallel_in;\n            else\n                for i in N-1 downto 1 loop\n                    shift_reg(i) <= shift_reg(i-1);\n                end loop;\n                shift_reg(0) <= '0';\n            end if;\n        end if;\n    end process;\n\n    serial_out <= shift_reg(N-1);\nend rtl;
entity FixedPointConverter is generic (M : integer; N : integer); port (float_value : in std_logic_vector(M-1 downto 0); fixed_point : out std_logic_vector(N-1 downto 0)); end FixedPointConverter;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity MemoryController is\n    generic (\n        DATA_WIDTH : integer := 8;\n        ADDR_WIDTH : integer := 8\n    );\n    port (\n        clk      : in  std_logic;\n        rst      : in  std_logic;\n        read_en  : in  std_logic;\n        write_en : in  std_logic;\n        addr     : in  std_logic_vector(ADDR_WIDTH - 1 downto 0);\n        data_in  : in  std_logic_vector(DATA_WIDTH - 1 downto 0);\n        data_out : out std_logic_vector(DATA_WIDTH - 1 downto 0)\n    );\nend MemoryController;\n\narchitecture Behavioral of MemoryController is\n    type memory_type is array (0 to (2 ** ADDR_WIDTH) - 1) of std_logic_vector(DATA_WIDTH - 1 downto 0);\n    signal memory : memory_type := (others => (others => '0'));\nbegin\n    process(clk)\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                data_out <= (others => '0');\n            else\n                if write_en = '1' then\n                    memory(to_integer(unsigned(addr))) <= data_in;\n                end if;\n\n                if read_en = '1' then\n                    data_out <= memory(to_integer(unsigned(addr)));\n                end if;\n            end if;\n        end if;\n    end process;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity frequency_divider is\n    generic (N : positive := 8);\n    port (\n        clock : in std_logic;\n        reset : in std_logic;\n        divide_ratio : in unsigned(N - 1 downto 0);\n        divided_clock : out std_logic\n    );\nend frequency_divider;\n\narchitecture rtl of frequency_divider is\n    signal counter : unsigned(N - 1 downto 0) := (others => '0');\n    signal divided_clock_reg : std_logic := '0';\nbegin\n    process(clock, reset)\n    begin\n        if reset = '1' then\n            counter <= (others => '0');\n            divided_clock_reg <= '0';\n        elsif rising_edge(clock) then\n            if divide_ratio = to_unsigned(0, N) then\n                counter <= (others => '0');\n                divided_clock_reg <= '0';\n            elsif counter = divide_ratio - to_unsigned(1, N) then\n                counter <= (others => '0');\n                divided_clock_reg <= not divided_clock_reg;\n            else\n                counter <= counter + to_unsigned(1, N);\n            end if;\n        end if;\n    end process;\n\n    divided_clock <= divided_clock_reg;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity SPI_Master_Multi_SS is\n    generic (\n        DATA_WIDTH : integer := 8;\n        NUM_SLAVES : integer := 4;\n        CLK_DIV : integer := 4\n    );\n    port (\n        clk : in std_logic;\n        rst : in std_logic;\n        start : in std_logic;\n        slave_sel : in integer range 0 to NUM_SLAVES - 1;\n        tx_data : in std_logic_vector(DATA_WIDTH - 1 downto 0);\n        miso : in std_logic;\n        mosi : out std_logic;\n        sclk : out std_logic;\n        ss_n : out std_logic_vector(NUM_SLAVES - 1 downto 0);\n        rx_data : out std_logic_vector(DATA_WIDTH - 1 downto 0);\n        busy : out std_logic;\n        done : out std_logic\n    );\nend SPI_Master_Multi_SS;\n\narchitecture rtl of SPI_Master_Multi_SS is\n    type state_type is (idle, transfer, finish);\n    signal state : state_type := idle;\n    signal div_cnt : integer range 0 to CLK_DIV - 1 := 0;\n    signal bit_cnt : integer range 0 to DATA_WIDTH - 1 := 0;\n    signal tx_shift : std_logic_vector(DATA_WIDTH - 1 downto 0) := (others => '0');\n    signal rx_shift : std_logic_vector(DATA_WIDTH - 1 downto 0) := (others => '0');\n    signal sclk_reg : std_logic := '0';\n    signal mosi_reg : std_logic := '0';\n    signal ss_reg : std_logic_vector(NUM_SLAVES - 1 downto 0) := (others => '1');\n    signal busy_reg : std_logic := '0';\n    signal done_reg : std_logic := '0';\nbegin\n    sclk <= sclk_reg;\n    mosi <= mosi_reg;\n    ss_n <= ss_reg;\n    rx_data <= rx_shift;\n    busy <= busy_reg;\n    done <= done_reg;\n\n    process(clk, rst)\n    begin\n        if rst = '1' then\n            state <= idle;\n            div_cnt <= 0;\n            bit_cnt <= 0;\n            tx_shift <= (others => '0');\n            rx_shift <= (others => '0');\n            sclk_reg <= '0';\n            mosi_reg <= '0';\n            ss_reg <= (others => '1');\n            busy_reg <= '0';\n            done_reg <= '0';\n        elsif rising_edge(clk) then\n            done_reg <= '0';\n\n            case state is\n                when idle =>\n                    sclk_reg <= '0';\n                    busy_reg <= '0';\n                    ss_reg <= (others => '1');\n\n                    if start = '1' then\n                        tx_shift <= tx_data;\n                        rx_shift <= (others => '0');\n                        bit_cnt <= DATA_WIDTH - 1;\n                        div_cnt <= 0;\n                        mosi_reg <= tx_data(DATA_WIDTH - 1);\n                        ss_reg <= (others => '1');\n                        ss_reg(slave_sel) <= '0';\n                        busy_reg <= '1';\n                        state <= transfer;\n                    end if;\n\n                when transfer =>\n                    busy_reg <= '1';\n\n                    if div_cnt = CLK_DIV - 1 then\n                        div_cnt <= 0;\n\n                        if sclk_reg = '0' then\n                            sclk_reg <= '1';\n                            rx_shift <= rx_shift(DATA_WIDTH - 2 downto 0) & miso;\n                        else\n                            sclk_reg <= '0';\n\n                            if bit_cnt = 0 then\n                                state <= finish;\n                            else\n                                bit_cnt <= bit_cnt - 1;\n                                tx_shift <= tx_shift(DATA_WIDTH - 2 downto 0) & '0';\n                                mosi_reg <= tx_shift(DATA_WIDTH - 2);\n                            end if;\n                        end if;\n                    else\n                        div_cnt <= div_cnt + 1;\n                    end if;\n\n                when finish =>\n                    ss_reg <= (others => '1');\n                    sclk_reg <= '0';\n                    busy_reg <= '0';\n                    done_reg <= '1';\n                    state <= idle;\n            end case;\n        end if;\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity pwm_generator is\n    generic (\n        COUNTER_WIDTH : integer := 16\n    );\n    port (\n        clk     : in  std_logic;\n        rst     : in  std_logic;\n        period  : in  unsigned(COUNTER_WIDTH - 1 downto 0);\n        duty    : in  unsigned(COUNTER_WIDTH - 1 downto 0);\n        pwm_out : out std_logic\n    );\nend pwm_generator;\n\narchitecture rtl of pwm_generator is\n    signal counter : unsigned(COUNTER_WIDTH - 1 downto 0) := (others => '0');\nbegin\n    process(clk)\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                counter <= (others => '0');\n            elsif counter >= period then\n                counter <= (others => '0');\n            else\n                counter <= counter + 1;\n            end if;\n        end if;\n    end process;\n\n    pwm_out <= '1' when counter < duty else '0';\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity CRC_checker is\n    generic (\n        N : positive := 8;\n        M : positive := 8\n    );\n    port (\n        data_in      : in  std_logic_vector(N-1 downto 0);\n        received_CRC : in  std_logic_vector(M-1 downto 0);\n        polynomial   : in  std_logic_vector(M-1 downto 0);\n        CRC_match    : out std_logic\n    );\nend CRC_checker;\n\narchitecture behavioral of CRC_checker is\nbegin\n    process(data_in, received_CRC, polynomial)\n        variable crc      : std_logic_vector(M-1 downto 0);\n        variable feedback : std_logic;\n    begin\n        crc := (others => '0');\n\n        for i in N-1 downto 0 loop\n            feedback := crc(M-1) xor data_in(i);\n\n            for j in M-1 downto 1 loop\n                crc(j) := crc(j-1);\n            end loop;\n\n            crc(0) := '0';\n\n            if feedback = '1' then\n                crc := crc xor polynomial;\n            end if;\n        end loop;\n\n        if crc = received_CRC then\n            CRC_match <= '1';\n        else\n            CRC_match <= '0';\n        end if;\n    end process;\nend behavioral;
entity FixedPointDivider is\n  generic (N : integer := 8);\n  port (\n    dividend  : in std_logic_vector(N-1 downto 0);\n    divisor   : in std_logic_vector(N-1 downto 0);\n    quotient  : out std_logic_vector(N-1 downto 0);\n    remainder : out std_logic_vector(N-1 downto 0)\n  );\nend FixedPointDivider;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity comparator_2bit is\n    port (\n        A1 : in std_logic;\n        A0 : in std_logic;\n        B1 : in std_logic;\n        B0 : in std_logic;\n        A_greater : out std_logic;\n        A_equal : out std_logic;\n        A_smaller : out std_logic\n    );\nend comparator_2bit;\n\narchitecture rtl of comparator_2bit is\nbegin\n    A_greater <= (A1 and not B1) or ((A1 xnor B1) and A0 and not B0);\n    A_equal <= (A1 xnor B1) and (A0 xnor B0);\n    A_smaller <= (not A1 and B1) or ((A1 xnor B1) and not A0 and B0);\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity BinaryToGray is\n    generic (N : positive := 8);\n    port (\n        binary : in std_logic_vector(N-1 downto 0);\n        gray_code : out std_logic_vector(N-1 downto 0)\n    );\nend BinaryToGray;\n\narchitecture rtl of BinaryToGray is\nbegin\n    gray_code(N-1) <= binary(N-1);\n\n    gen_gray : for i in 0 to N-2 generate\n        gray_code(i) <= binary(i+1) xor binary(i);\n    end generate;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity quadrature_encoder_interface is\n    generic (\n        WIDTH : integer := 32\n    );\n    port (\n        clk   : in  std_logic;\n        rst   : in  std_logic;\n        enc_a : in  std_logic;\n        enc_b : in  std_logic;\n        count : out signed(WIDTH - 1 downto 0)\n    );\nend quadrature_encoder_interface;\n\narchitecture rtl of quadrature_encoder_interface is\n    signal count_reg : signed(WIDTH - 1 downto 0) := (others => '0');\n    signal ab_prev   : std_logic_vector(1 downto 0) := (others => '0');\nbegin\n    process(clk, rst)\n        variable ab_curr : std_logic_vector(1 downto 0);\n    begin\n        if rst = '1' then\n            count_reg <= (others => '0');\n            ab_prev <= (others => '0');\n        elsif rising_edge(clk) then\n            ab_curr := enc_a & enc_b;\n\n            case ab_prev & ab_curr is\n                when "0001" | "0111" | "1110" | "1000" =>\n                    count_reg <= count_reg + 1;\n                when "0010" | "1011" | "1101" | "0100" =>\n                    count_reg <= count_reg - 1;\n                when others =>\n                    count_reg <= count_reg;\n            end case;\n\n            ab_prev <= ab_curr;\n        end if;\n    end process;\n\n    count <= count_reg;\nend rtl;
entity debouncer is port (noisy_button : in std_logic; clean_button_pulse : out std_logic); end debouncer;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity JohnsonCounter is\n    generic (\n        N : positive := 4\n    );\n    port (\n        clock : in std_logic;\n        reset : in std_logic;\n        count : out std_logic_vector(N-1 downto 0)\n    );\nend JohnsonCounter;\n\narchitecture Behavioral of JohnsonCounter is\n    signal count_reg : std_logic_vector(N-1 downto 0);\nbegin\n    process(clock, reset)\n    begin\n        if reset = '1' then\n            count_reg <= (others => '0');\n        elsif rising_edge(clock) then\n            count_reg <= not count_reg(0) & count_reg(N-1 downto 1);\n        end if;\n    end process;\n\n    count <= count_reg;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity PulseGenerator is\n    generic (\n        N : integer := 8\n    );\n    port (\n        clk : in std_logic;\n        reset : in std_logic;\n        pulse_width : in std_logic_vector(N-1 downto 0);\n        pulse_out : out std_logic\n    );\nend PulseGenerator;\n\narchitecture Behavioral of PulseGenerator is\n    signal counter : unsigned(N-1 downto 0) := (others => '0');\nbegin\n    process(clk, reset)\n    begin\n        if reset = '1' then\n            counter <= (others => '0');\n            pulse_out <= '0';\n        elsif rising_edge(clk) then\n            if counter < unsigned(pulse_width) then\n                counter <= counter + 1;\n                pulse_out <= '1';\n            else\n                pulse_out <= '0';\n            end if;\n        end if;\n    end process;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity MagnitudeComparator is\n    generic (K : integer := 8);\n    port (\n        A : in std_logic_vector(K-1 downto 0);\n        B : in std_logic_vector(K-1 downto 0);\n        A_GT_B : out std_logic;\n        A_EQ_B : out std_logic;\n        A_LT_B : out std_logic\n    );\nend MagnitudeComparator;\n\narchitecture Behavioral of MagnitudeComparator is\nbegin\n    A_GT_B <= '1' when unsigned(A) > unsigned(B) else '0';\n    A_EQ_B <= '1' when A = B else '0';\n    A_LT_B <= '1' when unsigned(A) < unsigned(B) else '0';\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity PseudoRandomNumberGenerator is\n    generic (N : positive := 8);\n    port (\n        clock : in std_logic;\n        seed_value : in std_logic_vector(N - 1 downto 0);\n        random_number : out std_logic_vector(N - 1 downto 0)\n    );\nend PseudoRandomNumberGenerator;\n\narchitecture Behavioral of PseudoRandomNumberGenerator is\n    signal lfsr : std_logic_vector(N - 1 downto 0) := (others => '0');\n\n    function next_lfsr(value : std_logic_vector) return std_logic_vector is\n        variable result : std_logic_vector(value'range);\n        variable feedback : std_logic;\n    begin\n        if value'length = 1 then\n            result := not value;\n        else\n            feedback := value(value'high) xor value(value'high - 1);\n            result := value(value'high - 1 downto value'low) & feedback;\n        end if;\n        return result;\n    end function;\nbegin\n    process(clock)\n    begin\n        if rising_edge(clock) then\n            if lfsr = (N - 1 downto 0 => '0') then\n                lfsr <= seed_value;\n            else\n                lfsr <= next_lfsr(lfsr);\n            end if;\n        end if;\n    end process;\n\n    random_number <= lfsr;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity ClockDivider is\n    generic (\n        DIVISOR : positive := 2\n    );\n    port (\n        clk     : in  std_logic;\n        rst     : in  std_logic;\n        clk_out : out std_logic\n    );\nend ClockDivider;\n\narchitecture rtl of ClockDivider is\n    signal counter : integer range 0 to DIVISOR - 1 := 0;\n    signal clk_reg : std_logic := '0';\nbegin\n    process(clk, rst)\n    begin\n        if rst = '1' then\n            counter <= 0;\n            clk_reg <= '0';\n        elsif rising_edge(clk) then\n            if counter = DIVISOR - 1 then\n                counter <= 0;\n            else\n                counter <= counter + 1;\n            end if;\n\n            if counter < DIVISOR / 2 then\n                clk_reg <= '1';\n            else\n                clk_reg <= '0';\n            end if;\n        end if;\n    end process;\n\n    clk_out <= clk_reg;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity astable_multivibrator is\n    port (\n        clk : in std_logic;\n        reset : in std_logic;\n        oscillating_out : out std_logic\n    );\nend astable_multivibrator;\n\narchitecture rtl of astable_multivibrator is\n    signal q : std_logic := '0';\nbegin\n    process(clk, reset)\n    begin\n        if reset = '1' then\n            q <= '0';\n        elsif rising_edge(clk) then\n            q <= not q;\n        end if;\n    end process;\n\n    oscillating_out <= q;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity RotatingPriorityEncoder is\n    generic (\n        N : integer := 8;\n        LOG2N : integer := 3\n    );\n    port (\n        request : in std_logic_vector(N-1 downto 0);\n        grant : out std_logic_vector(LOG2N-1 downto 0);\n        valid : out std_logic;\n        rotation_bit : out std_logic\n    );\nend RotatingPriorityEncoder;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.float_pkg.all;\n\nentity floating_point_adder is\n    generic (N : positive := 32);\n    port (\n        A   : in  std_logic_vector(N-1 downto 0);\n        B   : in  std_logic_vector(N-1 downto 0);\n        sum : out std_logic_vector(N-1 downto 0)\n    );\nend floating_point_adder;\n\narchitecture rtl of floating_point_adder is\nbegin\n    sum <= to_slv(to_float(A, 8, N - 9) + to_float(B, 8, N - 9));\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity comparator4 is\n    port (\n        a  : in  std_logic_vector(3 downto 0);\n        b  : in  std_logic_vector(3 downto 0);\n        eq : out std_logic;\n        gt : out std_logic;\n        lt : out std_logic\n    );\nend comparator4;\n\narchitecture Behavioral of comparator4 is\nbegin\n    eq <= '1' when a = b else '0';\n    gt <= '1' when unsigned(a) > unsigned(b) else '0';\n    lt <= '1' when unsigned(a) < unsigned(b) else '0';\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity mux2to1 is\n    port (\n        data0 : in std_logic;\n        data1 : in std_logic;\n        \select\ : in std_logic;\n        data_out : out std_logic\n    );\nend mux2to1;\n\narchitecture rtl of mux2to1 is\nbegin\n    data_out <= data0 when \select\ = '0' else data1;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity spi_master is\n  generic (\n    CLK_DIV : positive := 4\n  );\n  port (\n    clk      : in  std_logic;\n    rst      : in  std_logic;\n    start    : in  std_logic;\n    data_in  : in  std_logic_vector(7 downto 0);\n    miso     : in  std_logic;\n    mosi     : out std_logic;\n    sclk     : out std_logic;\n    cs       : out std_logic;\n    done     : out std_logic;\n    data_out : out std_logic_vector(7 downto 0)\n  );\nend spi_master;\n\narchitecture rtl of spi_master is\n  type state_type is (IDLE, TRANSFER, FINISH);\n  signal state        : state_type := IDLE;\n  signal clk_count    : integer range 0 to CLK_DIV - 1 := 0;\n  signal bit_count    : integer range 0 to 8 := 0;\n  signal shift_tx     : std_logic_vector(7 downto 0) := (others => '0');\n  signal shift_rx     : std_logic_vector(7 downto 0) := (others => '0');\n  signal mosi_reg     : std_logic := '0';\n  signal sclk_reg     : std_logic := '0';\n  signal cs_reg       : std_logic := '1';\n  signal done_reg     : std_logic := '0';\n  signal data_out_reg : std_logic_vector(7 downto 0) := (others => '0');\nbegin\n  mosi <= mosi_reg;\n  sclk <= sclk_reg;\n  cs <= cs_reg;\n  done <= done_reg;\n  data_out <= data_out_reg;\n\n  process(clk, rst)\n  begin\n    if rst = '1' then\n      state <= IDLE;\n      clk_count <= 0;\n      bit_count <= 0;\n      shift_tx <= (others => '0');\n      shift_rx <= (others => '0');\n      mosi_reg <= '0';\n      sclk_reg <= '0';\n      cs_reg <= '1';\n      done_reg <= '0';\n      data_out_reg <= (others => '0');\n    elsif rising_edge(clk) then\n      done_reg <= '0';\n\n      case state is\n        when IDLE =>\n          cs_reg <= '1';\n          sclk_reg <= '0';\n          clk_count <= 0;\n          bit_count <= 8;\n\n          if start = '1' then\n            cs_reg <= '0';\n            shift_tx <= data_in;\n            shift_rx <= (others => '0');\n            mosi_reg <= data_in(7);\n            state <= TRANSFER;\n          end if;\n\n        when TRANSFER =>\n          if clk_count = CLK_DIV - 1 then\n            clk_count <= 0;\n            sclk_reg <= not sclk_reg;\n\n            if sclk_reg = '0' then\n              shift_rx <= shift_rx(6 downto 0) & miso;\n\n              if bit_count = 1 then\n                state <= FINISH;\n              end if;\n            else\n              shift_tx <= shift_tx(6 downto 0) & '0';\n              mosi_reg <= shift_tx(6);\n              bit_count <= bit_count - 1;\n            end if;\n          else\n            clk_count <= clk_count + 1;\n          end if;\n\n        when FINISH =>\n          cs_reg <= '1';\n          sclk_reg <= '0';\n          data_out_reg <= shift_rx;\n          done_reg <= '1';\n          state <= IDLE;\n      end case;\n    end if;\n  end process;\nend rtl;
process(clk)\n  variable data_in_prev : std_logic := '0';\nbegin\n  if rising_edge(clk) then\n    data_out <= data_in_prev and not data_in;\n    data_in_prev := data_in;\n  end if;\nend process;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity universal_shift_register is\n    generic (P : positive := 8);\n    port (\n        clock : in std_logic;\n        shift_enable : in std_logic;\n        shift_direction : in std_logic;\n        serial_in : in std_logic;\n        parallel_out : out std_logic_vector(P-1 downto 0);\n        serial_out : out std_logic\n    );\nend universal_shift_register;\n\narchitecture rtl of universal_shift_register is\n    signal reg : std_logic_vector(P-1 downto 0) := (others => '0');\nbegin\n    process(clock)\n    begin\n        if rising_edge(clock) then\n            if shift_enable = '1' then\n                if shift_direction = '0' then\n                    reg <= serial_in & reg(P-1 downto 1);\n                else\n                    reg <= reg(P-2 downto 0) & serial_in;\n                end if;\n            end if;\n        end if;\n    end process;\n\n    parallel_out <= reg;\n    serial_out <= reg(0) when shift_direction = '0' else reg(P-1);\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity priority_encoder is\n    port (\n        data_in  : in  std_logic_vector(3 downto 0);\n        code_out : out std_logic_vector(1 downto 0);\n        valid    : out std_logic\n    );\nend priority_encoder;\n\narchitecture rtl of priority_encoder is\nbegin\n    process(data_in)\n    begin\n        valid <= '1';\n        if data_in(3) = '1' then\n            code_out <= "11";\n        elsif data_in(2) = '1' then\n            code_out <= "10";\n        elsif data_in(1) = '1' then\n            code_out <= "01";\n        elsif data_in(0) = '1' then\n            code_out <= "00";\n        else\n            code_out <= "00";\n            valid <= '0';\n        end if;\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity ring_counter is\n    generic (\n        N : integer := 4\n    );\n    port (\n        clock      : in  std_logic;\n        reset      : in  std_logic;\n        ring_count : out std_logic_vector(N-1 downto 0)\n    );\nend ring_counter;\n\narchitecture rtl of ring_counter is\n    signal count : std_logic_vector(N-1 downto 0);\nbegin\n    process(clock, reset)\n    begin\n        if reset = '1' then\n            count <= (0 => '1', others => '0');\n        elsif rising_edge(clock) then\n            count <= count(N-2 downto 0) & count(N-1);\n        end if;\n    end process;\n\n    ring_count <= count;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity binary_to_bcd is\n    port (\n        binary_in : in std_logic_vector(7 downto 0);\n        bcd_out   : out std_logic_vector(11 downto 0)\n    );\nend binary_to_bcd;\n\narchitecture rtl of binary_to_bcd is\nbegin\n    process(binary_in)\n        variable shift : unsigned(19 downto 0);\n    begin\n        shift := (others => '0');\n        shift(7 downto 0) := unsigned(binary_in);\n\n        for i in 0 to 7 loop\n            if shift(11 downto 8) > 4 then\n                shift(11 downto 8) := shift(11 downto 8) + 3;\n            end if;\n\n            if shift(15 downto 12) > 4 then\n                shift(15 downto 12) := shift(15 downto 12) + 3;\n            end if;\n\n            if shift(19 downto 16) > 4 then\n                shift(19 downto 16) := shift(19 downto 16) + 3;\n            end if;\n\n            shift := shift(18 downto 0) & '0';\n        end loop;\n\n        bcd_out <= std_logic_vector(shift(19 downto 8));\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity PulseGenerator is\n    generic (\n        N : integer := 10\n    );\n    port (\n        clk   : in  std_logic;\n        rst   : in  std_logic;\n        pulse : out std_logic\n    );\nend PulseGenerator;\n\narchitecture Behavioral of PulseGenerator is\n    signal counter : integer range 0 to N - 1 := 0;\nbegin\n    process(clk)\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                counter <= 0;\n                pulse <= '0';\n            elsif counter = N - 1 then\n                counter <= 0;\n                pulse <= '1';\n            else\n                counter <= counter + 1;\n                pulse <= '0';\n            end if;\n        end if;\n    end process;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity BinaryToBCD is\n    generic (\n        N : positive := 8\n    );\n    port (\n        binary_value : in std_logic_vector(N - 1 downto 0);\n        BCD_value : out std_logic_vector((((N / 3) + 1) * 4) - 1 downto 0)\n    );\nend BinaryToBCD;\n\narchitecture Behavioral of BinaryToBCD is\nbegin\n    process(binary_value)\n        variable bcd : unsigned((((N / 3) + 1) * 4) - 1 downto 0);\n    begin\n        bcd := (others => '0');\n\n        for i in 0 to N - 1 loop\n            for j in 0 to (N / 3) loop\n                if bcd((j * 4) + 3 downto j * 4) > 4 then\n                    bcd((j * 4) + 3 downto j * 4) := bcd((j * 4) + 3 downto j * 4) + 3;\n                end if;\n            end loop;\n\n            bcd := bcd(bcd'high - 1 downto 0) & binary_value(N - 1 - i);\n        end loop;\n\n        BCD_value <= std_logic_vector(bcd);\n    end process;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity dual_port_ram is\n    generic (\n        K : positive := 1024;\n        L : positive := 8;\n        ADDR_WIDTH : positive := 10\n    );\n    port (\n        clock : in std_logic;\n        write_enable : in std_logic;\n        read_enable : in std_logic;\n        write_address : in std_logic_vector(ADDR_WIDTH - 1 downto 0);\n        read_address : in std_logic_vector(ADDR_WIDTH - 1 downto 0);\n        data_in : in std_logic_vector(L - 1 downto 0);\n        data_out : out std_logic_vector(L - 1 downto 0)\n    );\nend dual_port_ram;\n\narchitecture rtl of dual_port_ram is\n    type ram_type is array (0 to K - 1) of std_logic_vector(L - 1 downto 0);\n    signal ram : ram_type;\nbegin\n    process(clock)\n    begin\n        if rising_edge(clock) then\n            if write_enable = '1' then\n                ram(to_integer(unsigned(write_address))) <= data_in;\n            end if;\n\n            if read_enable = '1' then\n                data_out <= ram(to_integer(unsigned(read_address)));\n            end if;\n        end if;\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity dual_port_memory is\n    generic (\n        K : integer := 256;\n        L : integer := 8;\n        log2K : integer := 8\n    );\n    port (\n        clock : in std_logic;\n        write : in std_logic;\n        address_w : in std_logic_vector(log2K - 1 downto 0);\n        address_r : in std_logic_vector(log2K - 1 downto 0);\n        data_write : in std_logic_vector(L - 1 downto 0);\n        data_read : out std_logic_vector(L - 1 downto 0)\n    );\nend dual_port_memory;\n\narchitecture rtl of dual_port_memory is\n    type memory_type is array (0 to K - 1) of std_logic_vector(L - 1 downto 0);\n    signal memory : memory_type;\nbegin\n    process(clock)\n    begin\n        if rising_edge(clock) then\n            if write = '1' then\n                memory(to_integer(unsigned(address_w))) <= data_write;\n            end if;\n            data_read <= memory(to_integer(unsigned(address_r)));\n        end if;\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity binary_counter is\n    port (\n        clk : in std_logic;\n        rst : in std_logic;\n        q : out std_logic_vector(3 downto 0)\n    );\nend binary_counter;\n\narchitecture rtl of binary_counter is\n    signal counter : unsigned(3 downto 0) := (others => '0');\nbegin\n    process(clk, rst)\n    begin\n        if rst = '1' then\n            counter <= (others => '0');\n        elsif rising_edge(clk) then\n            counter <= counter + 1;\n        end if;\n    end process;\n\n    q <= std_logic_vector(counter);\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity fir_filter is\n    generic (\n        N : positive := 8;\n        M : positive := 4\n    );\n    port (\n        clock : in std_logic;\n        reset : in std_logic;\n        data_in : in std_logic_vector(N - 1 downto 0);\n        coefficients : in std_logic_vector(M * N - 1 downto 0);\n        filtered_output : out std_logic_vector(N - 1 downto 0)\n    );\nend fir_filter;\n\narchitecture rtl of fir_filter is\n    type sample_array_t is array (0 to M - 1) of signed(N - 1 downto 0);\n    signal samples : sample_array_t := (others => (others => '0'));\n    constant ACC_WIDTH : integer := 2 * N + M;\nbegin\n    process(clock, reset)\n        variable new_samples : sample_array_t;\n        variable acc : signed(ACC_WIDTH - 1 downto 0);\n    begin\n        if reset = '1' then\n            samples <= (others => (others => '0'));\n            filtered_output <= (others => '0');\n        elsif rising_edge(clock) then\n            new_samples(0) := signed(data_in);\n            for i in 1 to M - 1 loop\n                new_samples(i) := samples(i - 1);\n            end loop;\n\n            acc := (others => '0');\n            for i in 0 to M - 1 loop\n                acc := acc + resize(new_samples(i) * signed(coefficients((i + 1) * N - 1 downto i * N)), ACC_WIDTH);\n            end loop;\n\n            samples <= new_samples;\n            filtered_output <= std_logic_vector(resize(acc, N));\n        end if;\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity clock_gating is\n    port (\n        clk       : in  std_logic;\n        enable    : in  std_logic;\n        gated_clk : out std_logic\n    );\nend clock_gating;\n\narchitecture rtl of clock_gating is\nbegin\n    gated_clk <= clk and enable;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.float_pkg.all;\n\nentity FloatingPointMultiplier is\n  generic (N : positive := 32);\n  port (\n    A : in std_logic_vector(N-1 downto 0);\n    B : in std_logic_vector(N-1 downto 0);\n    product : out std_logic_vector(N-1 downto 0)\n  );\nend FloatingPointMultiplier;\n\narchitecture rtl of FloatingPointMultiplier is\n  constant EXP_WIDTH : natural := N / 4;\n  constant FRAC_WIDTH : natural := N - EXP_WIDTH - 1;\nbegin\n  product <= std_logic_vector(to_slv(to_float(A, EXP_WIDTH, FRAC_WIDTH) * to_float(B, EXP_WIDTH, FRAC_WIDTH)));\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity BCD_to_binary_converter is\n    generic (N : integer := 8);\n    port (\n        BCD_value : in std_logic_vector(4 * ((N / 3) + 1) - 1 downto 0);\n        binary_value : out std_logic_vector(N - 1 downto 0)\n    );\nend BCD_to_binary_converter;\n\narchitecture rtl of BCD_to_binary_converter is\nbegin\n    process(BCD_value)\n        variable result : unsigned(N - 1 downto 0);\n        variable multiplier : unsigned(N - 1 downto 0);\n        variable digit : unsigned(3 downto 0);\n    begin\n        result := (others => '0');\n        multiplier := to_unsigned(1, N);\n\n        for i in 0 to (N / 3) loop\n            digit := unsigned(BCD_value(4 * i + 3 downto 4 * i));\n            result := result + resize(resize(digit, N) * multiplier, N);\n            multiplier := resize(multiplier * to_unsigned(10, N), N);\n        end loop;\n\n        binary_value <= std_logic_vector(result);\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity FrequencyMeter is\n    generic (\n        CLK_FREQ : integer := 50000000;\n        COUNT_WIDTH : integer := 32\n    );\n    port (\n        clk : in std_logic;\n        rst : in std_logic;\n        signal_in : in std_logic;\n        frequency : out unsigned(COUNT_WIDTH - 1 downto 0);\n        ready : out std_logic\n    );\nend FrequencyMeter;\n\narchitecture rtl of FrequencyMeter is\n    signal gate_counter : integer range 0 to CLK_FREQ - 1 := 0;\n    signal pulse_count : unsigned(COUNT_WIDTH - 1 downto 0) := (others => '0');\n    signal sync_0 : std_logic := '0';\n    signal sync_1 : std_logic := '0';\n    signal sync_prev : std_logic := '0';\nbegin\n    process(clk)\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                gate_counter <= 0;\n                pulse_count <= (others => '0');\n                frequency <= (others => '0');\n                ready <= '0';\n                sync_0 <= '0';\n                sync_1 <= '0';\n                sync_prev <= '0';\n            else\n                sync_0 <= signal_in;\n                sync_1 <= sync_0;\n                sync_prev <= sync_1;\n                ready <= '0';\n\n                if sync_1 = '1' and sync_prev = '0' then\n                    pulse_count <= pulse_count + 1;\n                end if;\n\n                if gate_counter = CLK_FREQ - 1 then\n                    gate_counter <= 0;\n                    frequency <= pulse_count;\n                    pulse_count <= (others => '0');\n                    ready <= '1';\n                else\n                    gate_counter <= gate_counter + 1;\n                end if;\n            end if;\n        end if;\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity DigitalDifferentiator is\n    generic (N : integer := 8);\n    port (\n        clk : in std_logic;\n        input_data : in std_logic_vector(N-1 downto 0);\n        differentiated_data : out std_logic_vector(N-1 downto 0)\n    );\nend DigitalDifferentiator;\n\narchitecture Behavioral of DigitalDifferentiator is\n    signal previous_data : std_logic_vector(N-1 downto 0) := (others => '0');\nbegin\n    process(clk)\n    begin\n        if rising_edge(clk) then\n            differentiated_data <= std_logic_vector(unsigned(input_data) - unsigned(previous_data));\n            previous_data <= input_data;\n        end if;\n    end process;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity digital_integrator is\n    generic (\n        N : integer := 8\n    );\n    port (\n        clock : in std_logic;\n        reset : in std_logic;\n        data_in : in std_logic_vector(N-1 downto 0);\n        integrated_output : out std_logic_vector(N-1 downto 0)\n    );\nend digital_integrator;\n\narchitecture rtl of digital_integrator is\n    signal accumulator : unsigned(N-1 downto 0) := (others => '0');\nbegin\n    process(clock, reset)\n    begin\n        if reset = '1' then\n            accumulator <= (others => '0');\n        elsif rising_edge(clock) then\n            accumulator <= accumulator + unsigned(data_in);\n        end if;\n    end process;\n\n    integrated_output <= std_logic_vector(accumulator);\nend rtl;
entity CRC_generator is generic (N : integer := 8; M : integer := 8); port (data_in : in std_logic_vector(N-1 downto 0); polynomial : in std_logic_vector(M-1 downto 0); CRC_value : out std_logic_vector(M-1 downto 0)); end CRC_generator;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity PriorityEncoder is\n    generic (\n        M : integer := 4\n    );\n    port (\n        requests : in std_logic_vector((2**M)-1 downto 0);\n        encoded  : out std_logic_vector(M-1 downto 0);\n        valid    : out std_logic\n    );\nend PriorityEncoder;\n\narchitecture Behavioral of PriorityEncoder is\nbegin\n    process(requests)\n        variable enc : unsigned(M-1 downto 0);\n        variable val : std_logic;\n    begin\n        enc := (others => '0');\n        val := '0';\n\n        for i in requests'range loop\n            if requests(i) = '1' then\n                enc := to_unsigned(i, M);\n                val := '1';\n                exit;\n            end if;\n        end loop;\n\n        encoded <= std_logic_vector(enc);\n        valid <= val;\n    end process;\nend Behavioral;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity UnsignedDivider is\n    generic (N : integer := 8);\n    port (\n        dividend  : in  unsigned(N-1 downto 0);\n        divisor   : in  unsigned(N-1 downto 0);\n        quotient  : out unsigned(N-1 downto 0);\n        remainder : out unsigned(N-1 downto 0)\n    );\nend UnsignedDivider;\n\narchitecture rtl of UnsignedDivider is\nbegin\n    quotient <= dividend / divisor;\n    remainder <= dividend mod divisor;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\n\nentity i2c_master is\n    generic (\n        CLK_FREQ : integer := 50000000;\n        I2C_FREQ : integer := 100000\n    );\n    port (\n        clk        : in std_logic;\n        rst        : in std_logic;\n        start      : in std_logic;\n        rw         : in std_logic;\n        slave_addr : in std_logic_vector(6 downto 0);\n        data_wr    : in std_logic_vector(7 downto 0);\n        data_rd    : out std_logic_vector(7 downto 0);\n        busy       : out std_logic;\n        done       : out std_logic;\n        ack_error  : out std_logic;\n        scl        : inout std_logic;\n        sda        : inout std_logic\n    );\nend i2c_master;\n\narchitecture rtl of i2c_master is\n    function max_int(a : integer; b : integer) return integer is\n    begin\n        if a > b then\n            return a;\n        else\n            return b;\n        end if;\n    end function;\n\n    constant DIVIDER : integer := max_int(1, CLK_FREQ / (I2C_FREQ * 2));\n\n    type state_type is (\n        IDLE,\n        START_1,\n        START_2,\n        BIT_LOW,\n        BIT_HIGH,\n        ACK_LOW,\n        ACK_HIGH,\n        READ_LOW,\n        READ_HIGH,\n        MASTER_NACK_LOW,\n        MASTER_NACK_HIGH,\n        STOP_1,\n        STOP_2,\n        STOP_3\n    );\n\n    type phase_type is (\n        ADDR_PHASE,\n        WRITE_PHASE,\n        READ_PHASE\n    );\n\n    signal state : state_type := IDLE;\n    signal phase : phase_type := ADDR_PHASE;\n    signal divider_cnt : integer range 0 to DIVIDER - 1 := 0;\n    signal bit_cnt : integer range 0 to 7 := 0;\n    signal shifter : std_logic_vector(7 downto 0) := (others => '0');\n    signal read_shift : std_logic_vector(7 downto 0) := (others => '0');\n    signal data_wr_reg : std_logic_vector(7 downto 0) := (others => '0');\n    signal data_rd_reg : std_logic_vector(7 downto 0) := (others => '0');\n    signal rw_reg : std_logic := '0';\n    signal scl_drive_low : std_logic := '0';\n    signal sda_drive_low : std_logic := '0';\n    signal busy_reg : std_logic := '0';\n    signal done_reg : std_logic := '0';\n    signal ack_error_reg : std_logic := '0';\nbegin\n    scl <= '0' when scl_drive_low = '1' else 'Z';\n    sda <= '0' when sda_drive_low = '1' else 'Z';\n\n    data_rd <= data_rd_reg;\n    busy <= busy_reg;\n    done <= done_reg;\n    ack_error <= ack_error_reg;\n\n    process(clk, rst)\n    begin\n        if rst = '1' then\n            state <= IDLE;\n            phase <= ADDR_PHASE;\n            divider_cnt <= 0;\n            bit_cnt <= 0;\n            shifter <= (others => '0');\n            read_shift <= (others => '0');\n            data_wr_reg <= (others => '0');\n            data_rd_reg <= (others => '0');\n            rw_reg <= '0';\n            scl_drive_low <= '0';\n            sda_drive_low <= '0';\n            busy_reg <= '0';\n            done_reg <= '0';\n            ack_error_reg <= '0';\n        elsif rising_edge(clk) then\n            done_reg <= '0';\n\n            if divider_cnt = DIVIDER - 1 then\n                divider_cnt <= 0;\n\n                case state is\n                    when IDLE =>\n                        scl_drive_low <= '0';\n                        sda_drive_low <= '0';\n                        busy_reg <= '0';\n\n                        if start = '1' then\n                            busy_reg <= '1';\n                            ack_error_reg <= '0';\n                            rw_reg <= rw;\n                            data_wr_reg <= data_wr;\n                            shifter <= slave_addr & rw;\n                            bit_cnt <= 7;\n                            phase <= ADDR_PHASE;\n                            state <= START_1;\n                        end if;\n\n                    when START_1 =>\n                        scl_drive_low <= '0';\n                        sda_drive_low <= '0';\n                        state <= START_2;\n\n                    when START_2 =>\n                        scl_drive_low <= '0';\n                        sda_drive_low <= '1';\n                        state <= BIT_LOW;\n\n                    when BIT_LOW =>\n                        scl_drive_low <= '1';\n                        if shifter(bit_cnt) = '0' then\n                            sda_drive_low <= '1';\n                        else\n                            sda_drive_low <= '0';\n                        end if;\n                        state <= BIT_HIGH;\n\n                    when BIT_HIGH =>\n                        scl_drive_low <= '0';\n                        if bit_cnt = 0 then\n                            state <= ACK_LOW;\n                        else\n                            bit_cnt <= bit_cnt - 1;\n                            state <= BIT_LOW;\n                        end if;\n\n                    when ACK_LOW =>\n                        scl_drive_low <= '1';\n                        sda_drive_low <= '0';\n                        state <= ACK_HIGH;\n\n                    when ACK_HIGH =>\n                        scl_drive_low <= '0';\n                        sda_drive_low <= '0';\n\n                        if sda = '1' then\n                            ack_error_reg <= '1';\n                            state <= STOP_1;\n                        elsif phase = ADDR_PHASE then\n                            if rw_reg = '0' then\n                                phase <= WRITE_PHASE;\n                                shifter <= data_wr_reg;\n                                bit_cnt <= 7;\n                                state <= BIT_LOW;\n                            else\n                                phase <= READ_PHASE;\n                                bit_cnt <= 7;\n                                state <= READ_LOW;\n                            end if;\n                        else\n                            state <= STOP_1;\n                        end if;\n\n                    when READ_LOW =>\n                        scl_drive_low <= '1';\n                        sda_drive_low <= '0';\n                        state <= READ_HIGH;\n\n                    when READ_HIGH =>\n                        scl_drive_low <= '0';\n                        sda_drive_low <= '0';\n                        read_shift(bit_cnt) <= sda;\n\n                        if bit_cnt = 0 then\n                            state <= MASTER_NACK_LOW;\n                        else\n                            bit_cnt <= bit_cnt - 1;\n                            state <= READ_LOW;\n                        end if;\n\n                    when MASTER_NACK_LOW =>\n                        scl_drive_low <= '1';\n                        sda_drive_low <= '0';\n                        state <= MASTER_NACK_HIGH;\n\n                    when MASTER_NACK_HIGH =>\n                        scl_drive_low <= '0';\n                        sda_drive_low <= '0';\n                        data_rd_reg <= read_shift;\n                        state <= STOP_1;\n\n                    when STOP_1 =>\n                        scl_drive_low <= '1';\n                        sda_drive_low <= '1';\n                        state <= STOP_2;\n\n                    when STOP_2 =>\n                        scl_drive_low <= '0';\n                        sda_drive_low <= '1';\n                        state <= STOP_3;\n\n                    when STOP_3 =>\n                        scl_drive_low <= '0';\n                        sda_drive_low <= '0';\n                        busy_reg <= '0';\n                        done_reg <= '1';\n                        state <= IDLE;\n                end case;\n            else\n                divider_cnt <= divider_cnt + 1;\n            end if;\n        end if;\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity DDS is\n    port (\n        clk          : in  std_logic;\n        rst          : in  std_logic;\n        phase_inc    : in  unsigned(31 downto 0);\n        waveform_out : out signed(7 downto 0)\n    );\nend DDS;\n\narchitecture rtl of DDS is\n    signal phase_acc : unsigned(31 downto 0) := (others => '0');\n\n    type sine_rom_t is array (0 to 15) of signed(7 downto 0);\n    constant sine_rom : sine_rom_t := (\n        to_signed(0, 8),\n        to_signed(49, 8),\n        to_signed(90, 8),\n        to_signed(117, 8),\n        to_signed(127, 8),\n        to_signed(117, 8),\n        to_signed(90, 8),\n        to_signed(49, 8),\n        to_signed(0, 8),\n        to_signed(-49, 8),\n        to_signed(-90, 8),\n        to_signed(-117, 8),\n        to_signed(-128, 8),\n        to_signed(-117, 8),\n        to_signed(-90, 8),\n        to_signed(-49, 8)\n    );\nbegin\n    process(clk)\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                phase_acc <= (others => '0');\n                waveform_out <= (others => '0');\n            else\n                phase_acc <= phase_acc + phase_inc;\n                waveform_out <= sine_rom(to_integer(phase_acc(31 downto 28)));\n            end if;\n        end if;\n    end process;\nend rtl;
library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity Comparator is\n    generic (\n        K : integer := 8\n    );\n    port (\n        value1  : in  std_logic_vector(K-1 downto 0);\n        value2  : in  std_logic_vector(K-1 downto 0);\n        greater : out std_logic;\n        equal   : out std_logic;\n        smaller : out std_logic\n    );\nend Comparator;\n\narchitecture Behavioral of Comparator is\nbegin\n    greater <= '1' when unsigned(value1) > unsigned(value2) else '0';\n    equal   <= '1' when unsigned(value1) = unsigned(value2) else '0';\n    smaller <= '1' when unsigned(value1) < unsigned(value2) else '0';\nend Behavioral;
