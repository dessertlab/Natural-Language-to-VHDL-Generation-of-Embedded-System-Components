entity Monostable_Multivibrator is generic(N: integer := 8); port(trigger: in std_logic; pulse_out: out std_logic; pulse_duration: out std_logic_vector(N-1 downto 0)); end Monostable_Multivibrator; architecture Behavioral of Monostable_Multivibrator is signal timer: unsigned(N-1 downto 0) := (others => '0'); signal pulse_active: boolean := false; begin process(trigger) begin if rising_edge(trigger) then pulse_out <= '1'; timer <= (others => '1'); pulse_active <= true; end if; end process; process begin if pulse_active then if timer /= (others => '0') then timer <= timer - 1; else pulse_out <= '0'; pulse_active <= false; end if; end if; end process; pulse_duration <= std_logic_vector(timer); end Behavioral;
entity PWM_Generator is generic(CLK_FREQ:integer:=100_000_000;PWM_FREQ:integer:=1_000;DUTY_CYCLE:real:=0.5);port(clk,in std_logic;rst_n,in std_logic;enable,in std_logic;duty_cycle,in real range 0.0 to 1.0;pwm_out,out std_logic);end entity PWM_Generator;architecture Behavioral of PWM_Generator is constant CLK_PERIOD:time:=1 sec/real(CLK_FREQ);constant PWM_PERIOD:time:=1 sec/real(PWM_FREQ);signal counter:integer range 0 to CLK_FREQ/PWM_FREQ-1:=0;signal pwm_internal:std_logic:='0';begin process(clk,rst_n)begin if rst_n='0'then counter<=0;pwm_internal<='0';elsif rising_edge(clk)then if enable='1'then if counter<integer(real(CLK_FREQ)*duty_cycle/real(PWM_FREQ))then pwm_internal<='1';else pwm_internal<='0';end if;counter<=counter+1;if counter=integer(CLK_FREQ/PWM_FREQ)-1 then counter<=0;end if;else pwm_internal<='0';end if;end if;end process;pwm_out<=pwm_internal;end Behavioral;
entity Divider is generic(N:integer:=8;M:integer:=4);port(dividend:in std_logic_vector(N-1 downto 0);divisor:in std_logic_vector(M-1 downto 0);quotient:out std_logic_vector(N-M downto 0);remainder:out std_logic_vector(M-1 downto 0));end entity Divider;architecture Behavioral of Divider is begin quotient<=std_logic_vector(to_unsigned(to_integer(unsigned(dividend))/to_integer(unsigned(divisor)),N-M+1));remainder<=std_logic_vector(to_unsigned(to_integer(unsigned(dividend))mod to_integer(unsigned(divisor)),M));end Behavioral;
entity CRC8_Calculator is Port(clk,in std_logic;reset,in std_logic;data_in,in std_logic_vector(7 downto 0);crc_out,out std_logic_vector(7 downto 0));end CRC8_Calculator;architecture Behavioral of CRC8_Calculator is constant CRC_POLY,std_logic_vector(7 downto 0):="100000111";signal crc_reg,std_logic_vector(7 downto 0);begin process(clk,reset)begin if reset='1' then crc_reg<=(others=>'0');elsif rising_edge(clk)then if data_in(7)='1' then crc_reg<=std_logic_vector(unsigned(crc_reg) xor unsigned(CRC_POLY));end if;crc_reg(7 downto 1)<=crc_reg(6 downto 0);crc_reg(0)<=data_in(7);end if;end process;crc_out<=crc_reg;end Behavioral;
entity fifo_buffer is generic(W:integer:=8;D:integer:=16);port(c,r,in in std_logic;e,q,data in std_logic_vector(W-1 downto 0);out std_logic_vector(W-1 downto 0),f,e out std_logic);end fifo_buffer;architecture Behavioral of fifo_buffer is type m is array(0 to D-1)of std_logic_vector(W-1 downto 0);signal m:m:=((others=>(others=>'0')));signal r,w:integer range 0 to D-1:=0;signal c:integer range 0 to D:=0;begin process(c,r)begin if r='1'then r:=0;w:=0;c:=0;elsif rising_edge(c)then if in='1'and'1'=f then m(w)<=data;w:=w+1;if w=D then w:=0;end if;c:=c+1;end if;if e='1'and 1=f then out<=m(r);r:=r+1;if r=D then r:=0;end if;c:=c-1;end if;end if;end process;f<=('1'when c=D else'0');e<=('1'when c=0 else'0');end Behavioral;
entity johnson_counter is port(clk:in std_logic;reset:in std_logic;Johnson_count:out std_logic_vector(N-1 downto 0));end entity johnson_counter;architecture Behavioral of johnson_counter is signal count:std_logic_vector(N-1 downto 0):=(others=>'0');begin process(clk,reset)begin if reset='1' then count<=(others=>'0');elsif rising_edge(clk) then if count=(others=>'0') then count<=(others=>'1');else count<=count(N-2 downto 0)&(not count(N-1));end if;end if;end process;Johnson_count<=count;end Behavioral;
entity ring_oscillator is port(clk_in:in std_logic;clk_out:out std_logic);architecture Behavioral of ring_oscillator is signal i:std_logic_vector(2 downto 0);begin i(0)<=not i(2);i(1)<=not i(0);i(2)<=not i(1);clk_out<=i(2);end Behavioral;
entity debouncer is generic(CLK_PERIOD:time:=10ns);port(clk:in std_logic;noisy_in:in std_logic;debounced_out:out std_logic);end debouncer;architecture Behavioral of debouncer is signal debounced_signal:std_logic;begin process(clk)begin if rising_edge(clk)then debounced_signal<=noisy_in;end if;end process;debounced_out<=debounced_signal;end Behavioral;
entity rising_edge_detector is port(clk:in std_logic;signal_in:in std_logic;rising_edge_detected:out std_logic);end entity rising_edge_detector;architecture Behavioral of rising_edge_detector is signal prev_signal:std_logic:='0';begin process(clk)begin if rising_edge(clk)then if signal_in='1'and prev_signal='0'then rising_edge_detected<='1';else rising_edge_detected<='0';end if;prev_signal<=signal_in;end if;end process;end architecture Behavioral;
entity digital_integrator is port(clock: in std_logic; reset: in std_logic; data_in: in std_logic_vector(N-1 downto 0); integrated_output: out std_logic_vector(N-1 downto 0)); architecture Behavioral of digital_integrator is signal accumulator: std_logic_vector(N-1 downto 0) := (others => '0'); begin process (clock, reset) begin if reset = '1' then accumulator <= (others => '0'); elsif rising_edge(clock) then accumulator <= accumulator + data_in; end if; end process; integrated_output <= accumulator; end architecture Behavioral;
entity lfsr is port(clock: in std_logic; reset: in std_logic; seed_value: in std_logic_vector(N-1 downto 0); lfsr_output: out std_logic_vector(N-1 downto 0));architecture Behavioral of lfsr is signal lfsr_reg: std_logic_vector(N-1 downto 0); begin process(clock, reset) begin if reset = '1' then lfsr_reg <= seed_value; elsif rising_edge(clock) then lfsr_reg(N-1 downto 1) <= lfsr_reg(N-2 downto 0); lfsr_reg(0) <= lfsr_reg(N-1) xor lfsr_reg(N-2) xor ... xor lfsr_reg(0); end if; end process; lfsr_output <= lfsr_reg; end architecture Behavioral;
entity pulse_generator is port(clk,rst:in std_logic;pulse_out:out std_logic);architecture Behavioral of pulse_generator is signal pulse_internal:std_logic:='0';begin process(clk,rst)begin if rst='1'then pulse_internal<='0';elsif rising_edge(clk)then pulse_internal<=not pulse_internal;end if;end process;pulse_out<=pulse_internal;end architecture Behavioral;
entity decoder_2_4 is port(A,B:in std_logic;D0,D1,D2,D3:out std_logic);architecture Behavioral of decoder_2_4 is begin D0<=not A and not B;D1<=not A and B;D2<=A and not B;D3<=A and B;end architecture Behavioral;
entity pseudo_random_generator is port (clock: in std_logic; seed: in std_logic_vector(N-1 downto 0); random_number: out std_logic_vector(N-1 downto 0)); end entity pseudo_random_generator; architecture Behavioral of pseudo_random_generator is signal lfsr: std_logic_vector(N-1 downto 0); begin process(clock) begin if rising_edge(clock) then lfsr(N-1 downto 1) <= lfsr(N-2 downto 0); lfsr(0) <= lfsr(N-1) xor lfsr(N-2) xor ... xor lfsr(0); random_number <= lfsr; end if; end process; end architecture Behavioral;
process (clk, reset) begin if reset = '1' then Johnson_count <= (others => '0'); elsif rising_edge(clk) then if Johnson_count = "0001" then Johnson_count <= "0010"; elsif Johnson_count = "0010" then Johnson_count <= "0100"; elsif Johnson_count = "0100" then Johnson_count <= "1000"; elsif Johnson_count = "1000" then Johnson_count <= "0001"; else Johnson_count <= Johnson_count; end if; end if; end process;
entity floating_point_multiplier is generic(N:integer:=32);port(A:in std_logic_vector(N-1 downto 0);B:in std_logic_vector(N-1 downto 0);product:out std_logic_vector(N-1 downto 0));architecture behavioral of floating_point_multiplier is constant EXP_WIDTH:integer:=8;constant MANT_WIDTH:integer:=N-1-EXP_WIDTH;signal signA,signB:std_logic;signal expA,expB:std_logic_vector(EXP_WIDTH-1 downto 0);signal mantA,mantB:std_logic_vector(MANT_WIDTH-1 downto 0);signal signProduct:std_logic;signal expProduct:std_logic_vector(EXP_WIDTH-1 downto 0);signal mantProduct:std_logic_vector(MANT_WIDTH-1 downto 0);begin signA<=A(N-1);expA<=A(N-2 downto N-1-EXP_WIDTH);mantA<=A(N-2-EXP_WIDTH downto 0);signB<=B(N-1);expB<=B(N-2 downto N-1-EXP_WIDTH);mantB<=B(N-2-EXP_WIDTH downto 0);mantProduct<=mantA*mantB;expProduct<=expA+expB;signProduct<=signA xor signB;product<=signProduct&expProduct&mantProduct;end architecture behavioral;
entity glitch_filter is Port(noisy_in:in std_logic;filtered_out:out std_logic);architecture Behavioral of glitch_filter is signal filter_reg:std_logic:='0';begin process(noisy_in)begin if(rising_edge(noisy_in))then filter_reg<=noisy_in;end if;filtered_out<=filter_reg;end process;end architecture Behavioral;
entity crc_generator is generic(WIDTH: integer := 8); port(clk, reset: in std_logic; data_in: in std_logic_vector(WIDTH-1 downto 0); crc_out: out std_logic_vector(WIDTH-1 downto 0)); end entity crc_generator; architecture Behavioral of crc_generator is signal crc_reg: std_logic_vector(WIDTH-1 downto 0):=(others=>'0'); constant POLYNOMIAL: std_logic_vector(WIDTH-1 downto 0):=x"4D";begin process(clk,reset)begin if reset='1' then crc_reg<=(others=>'0');elsif rising_edge(clk) then crc_reg(WIDTH-1 downto 1)<=crc_reg(WIDTH-2 downto 0);if data_in(WIDTH-1)='1' then crc_reg(0)<=not crc_reg(WIDTH-2 downto 0) xor POLYNOMIAL;else crc_reg(0)<=crc_reg(WIDTH-2 downto 0);end if;end if;end process;crc_out<=crc_reg;end architecture Behavioral;
entity hamming_decoder is port(encoded: in std_logic_vector(6 downto 0); data_out: out std_logic_vector(3 downto 0); error_detected: out std_logic); architecture Behavioral of hamming_decoder is begin process(encoded) begin case encoded(6 downto 3) is when "000" => data_out <= encoded(2 downto 0); when "001" => data_out <= encoded(2 downto 0); when "010" => data_out <= "0" & encoded(2 downto 0); when "011" => data_out <= encoded(2) & not encoded(1 downto 0); when "100" => data_out <= encoded(2) & encoded(1 downto 0); when "101" => data_out <= not encoded(2) & encoded(1 downto 0); when "110" => data_out <= encoded(2 downto 0); when "111" => data_out <= encoded(2 downto 0); when others => data_out <= (others => '0'); end case; error_detected <= '1' when (encoded(6 downto 3) /= "000" and encoded(6 downto 3) /= "111") else '0'; end process; end architecture Behavioral;
entity parity_checker is port(D3, D2, D1, D0: in std_logic; even_parity, odd_parity: out std_logic); architecture Behavioral of parity_checker is begin even_parity <= D3 xor D2 xor D1 xor D0; odd_parity <= not (D3 xor D2 xor D1 xor D0); end Behavioral;
entity counter_4bit_sync_reset is port(clk,in std_logic;reset,in std_logic;count,out std_logic_vector(3 downto 0));architecture Behavioral of counter_4bit_sync_reset is begin process(clk,reset)begin if reset='1' then count<="0000";elsif rising_edge(clk)then count<=count+1;end if;end process;end architecture Behavioral;
entity clock_gating is port(clk,in std_logic;enable,in std_logic;gated_clk,out std_logic);architecture Behavioral of clock_gating is begin process(clk)begin if rising_edge(clk)then if enable='1'then gated_clk<=clk;else gated_clk<='0';end if;end if;end process;end architecture Behavioral;
entity parity_checker is port(data_in:in std_logic_vector(7 downto 0);parity_ok:out std_logic);architecture Behavioral of parity_checker is begin process(data_in)variable parity_count:integer:=0;begin for i in data_in'range loop if data_in(i)='1'then parity_count:=parity_count+1;end if;end loop;parity_ok<='1'when parity_count mod 2=0 else '0';end process;end architecture;
entity edge_detector is port(signal_in:in std_logic;rising_edge,falling_edge:out std_logic);end entity;architecture Behavioral of edge_detector is signal signal_in_delayed:std_logic:='0';begin process(signal_in)begin signal_in_delayed<=signal_in;rising_edge<='1'when(signal_in='1'and signal_in_delayed='0')else'0';falling_edge<='1'when(signal_in='0'and signal_in_delayed='1')else'0';end process;end architecture;
entity excess3_to_bcd_converter is port(excess3_value : in std_logic_vector(3 downto 0); BCD_value : out std_logic_vector(3 downto 0)); end entity; architecture Behavioral of excess3_to_bcd_converter is begin process(excess3_value) begin case excess3_value is when "0000" => BCD_value <= "0011"; when "0001" => BCD_value <= "0100"; when "0010" => BCD_value <= "0101"; when "0011" => BCD_value <= "0110"; when "0100" => BCD_value <= "0111"; when "0101" => BCD_value <= "1000"; when "0110" => BCD_value <= "1001"; when "0111" => BCD_value <= "0000"; when "1000" => BCD_value <= "0001"; when "1001" => BCD_value <= "0010"; when others => BCD_value <= "0000"; end case; end process; end architecture;
entity multiplier_4bit is port(A, B : in std_logic_vector(3 downto 0); product : out std_logic_vector(7 downto 0)); architecture Behavioral of multiplier_4bit is begin process(A, B) variable result : std_logic_vector(7 downto 0); begin result := (others => '0'); for i in 0 to 3 loop if B(i) = '1' then result := std_logic_vector(unsigned(result) + (unsigned(A) shl i)); end if; end loop; product <= result; end process; end architecture;
entity gated_d_latch is port(d,in std_logic;g,in std_logic;q,out std_logic);architecture Behavioral of gated_d_latch is begin process(d,g)begin if g='1'then q<=d;end if;end process;end Behavioral;
entity lfsr is generic(taps: std_logic_vector; width: integer);port(clk, rst: in std_logic; en: in std_logic; q: out std_logic_vector(width - 1 downto 0));end entity;architecture Behavioral of lfsr is signal reg: std_logic_vector(width - 1 downto 0);begin process(clk, rst) begin if rst = '1' then reg <= (others => '0'); elsif rising_edge(clk) then if en = '1' then reg(width - 1 downto 1) <= reg(width - 2 downto 0); reg(0) <= reg(width - 1) xor reg(taps); end if; end if; end process; q <= reg; end Behavioral;
entity bidirectional_shift_register is generic(P: integer);port(clk, clear, ser_in, shift_en, shift_dir: in std_logic; par_out: out std_logic_vector(P - 1 downto 0); ser_out: out std_logic);end entity;architecture Behavioral of bidirectional_shift_register is signal reg: std_logic_vector(P - 1 downto 0);begin process(clk, clear) begin if clear = '1' then reg <= (others => '0'); elsif rising_edge(clk) then if shift_en = '1' then if shift_dir = '0' then reg(P - 1 downto 1) <= reg(P - 2 downto 0); reg(0) <= ser_in; else reg(P - 2 downto 0) <= reg(P - 1 downto 1); reg(P - 1) <= ser_in; end if; end if; end if; end process; par_out <= reg; ser_out <= reg(0); end Behavioral;
entity parity_checker is port(D3, D2, D1, D0: in std_logic; even, odd: out std_logic); end entity;
entity adder is port(A, B: in std_logic_vector(N-1 downto 0); carry_in: in std_logic; sum: out std_logic_vector(N-1 downto 0); carry_out: out std_logic); end entity;
entity barrel_shifter is port(In3, In2, In1, In0: in std_logic; shift_left, shift_right: in std_logic; shift_amount: in std_logic_vector(1 downto 0); Out3, Out2, Out1, Out0: out std_logic); end entity;
entity glitch_filter is port(noisy_signal: in std_logic; filtered_signal: out std_logic); end entity glitch_filter;
entity digital_clock is port(clk,in std_logic;reset,in std_logic;hour_out,out integer range 0 to 23;minute_out,out integer range 0 to 59;second_out,out integer range 0 to 59);architecture Behavioral of digital_clock is signal hour_reg,minute_reg,second_reg:integer range 0 to 59:=0;begin process(clk,reset)begin if reset='1'then hour_reg<=0;minute_reg<=0;second_reg<=0;elsif rising_edge(clk)then if second_reg=59 then second_reg<=0;if minute_reg=59 then minute_reg<=0;if hour_reg=23 then hour_reg<=0;else hour_reg<=hour_reg+1;end if;else minute_reg<=minute_reg+1;end if;else second_reg<=second_reg+1;end if;end if;end process;hour_out<=hour_reg;minute_out<=minute_reg;second_out<=second_reg;end architecture Behavioral;;
entity clock_divider is generic(DIVIDER_VALUE: integer := 2); port(clk_in: in std_logic; reset: in std_logic; clk_out: out std_logic); end entity clock_divider; architecture Behavioral of clock_divider is signal counter: integer range 0 to DIVIDER_VALUE - 1 := 0; begin process(clk_in, reset) begin if reset = '1' then counter <= 0; clk_out <= '0'; elsif rising_edge(clk_in) then if counter = DIVIDER_VALUE - 1 then counter <= 0; clk_out <= not clk_out; else counter <= counter + 1; end if; end if; end process; end architecture Behavioral;
entity dual_clock_fifo is generic (DATA_WIDTH: integer := 8; DEPTH: integer := 16); port (clk1, clk2, reset, read_enable, write_enable: in std_logic; data_in: in std_logic_vector(DATA_WIDTH - 1 downto 0); data_out: out std_logic_vector(DATA_WIDTH - 1 downto 0); empty, full: out std_logic); end entity dual_clock_fifo; architecture Behavioral of dual_clock_fifo is type memory_array is array (0 to DEPTH - 1) of std_logic_vector(DATA_WIDTH - 1 downto 0); signal fifo_memory: memory_array := (others => (others => '0')); signal read_ptr, write_ptr: integer range 0 to DEPTH - 1 := 0; signal count: integer range 0 to DEPTH := 0; begin process (clk1, reset) begin if reset = '1' then read_ptr <= 0; write_ptr <= 0; count <= 0; elsif rising_edge(clk1) then if read_enable = '1' then if count > 0 then data_out <= fifo_memory(read_ptr); read_ptr <= (read_ptr + 1) mod DEPTH; count <= count - 1; end if; end if; end if; end process; process (clk2, reset) begin if reset = '1' then read_ptr <= 0; write_ptr <= 0; count <= 0; elsif rising_edge(clk2) then if write_enable = '1' then if count < DEPTH then fifo_memory(write_ptr) <= data_in; write_ptr <= (write_ptr + 1) mod DEPTH; count <= count + 1; end if; end if; end if; end process; empty <= '1' when count = 0 else '0'; full <= '1' when count = DEPTH else '0'; end architecture Behavioral;
entity barrel_shifter is generic(N:integer:=8);port(data_in:in std_logic_vector(N-1 downto 0);shift_left,shift_right:in std_logic;shift_amount:in unsigned(log2(N)-1 downto 0);data_out:out std_logic_vector(N-1 downto 0));end entity barrel_shifter;architecture Behavioral of barrel_shifter is begin process(data_in,shift_left,shift_right,shift_amount)begin if shift_left='1' then data_out<=data_in(N-1 downto shift_amount)&(others=>'0');elsif shift_right='1' then data_out<=(others=>'0')&data_in(N-1 downto shift_amount);else data_out<=data_in;end if;end process;end architecture Behavioral;
entity johnson_counter is generic (N : integer := 4); port (clock, reset : in std_logic; Johnson_count : out std_logic_vector(N-1 downto 0)); end entity johnson_counter; architecture Behavioral of johnson_counter is signal count : std_logic_vector(N downto 0); begin process(clock, reset) begin if reset = '1' then count <= (others => '0'); elsif rising_edge(clock) then if count = (others => '0') then count <= (others => '1'); else count <= count(0) & count(N downto 1); end if; end if; end process; Johnson_count <= count(N-1 downto 0); end architecture Behavioral;
entity uart_transmitter is port (clk,in std_logic;reset_n,in std_logic;tx_data,in std_logic_vector(7 downto 0);tx_start,in std_logic;tx_busy,out std_logic;tx_done,out std_logic);end entity uart_transmitter;architecture Behavioral of uart_transmitter is signal tx_state,integer range 0 to 1 := 0;signal tx_count,integer range 0 to 9 := 0;signal tx_bit,std_logic := '0';signal shift_reg,std_logic_vector(9 downto 0);constant BIT_TIME,integer := 10;begin process (clk,reset_n) begin if reset_n = '0' then tx_state <= 0;tx_count <= 0;tx_bit <= '0';tx_busy <= '0';tx_done <= '0';shift_reg <= (others => '0');elsif rising_edge(clk) then case tx_state is when 0 =>if tx_start = '1' then shift_reg <= '0' & tx_data & '1';tx_count <= 0;tx_state <= 1;tx_busy <= '1';else tx_busy <= '0';tx_done <= '0';end if;when 1 =>if tx_count < 10 then tx_bit <= shift_reg(tx_count);tx_count <= tx_count + 1;else tx_state <= 0;tx_busy <= '0';tx_done <= '1';end if;end case;end if;end process;end Behavioral;
entity fifo_controller is generic(WIDTH:integer:=8);port(clk,reset_n,push,pop:in std_logic;data_in:in std_logic_vector(WIDTH-1 downto 0);full,empty:out std_logic;data_out:out std_logic_vector(WIDTH-1 downto 0));end fifo_controller;architecture Behavioral of fifo_controller is type fifo_memory is array(0 to 7)of std_logic_vector(WIDTH-1 downto 0);signal fifo:fifo_memory:=(others=>(others=>'0'));signal head_ptr,tail_ptr:integer range 0 to 7:=0;begin process(clk,reset_n)begin if reset_n='0'then head_ptr<=0;tail_ptr<=0;elsif rising_edge(clk)then if push='1'and not full then fifo(tail_ptr)<=data_in;tail_ptr<=tail_ptr+1;if tail_ptr=8then tail_ptr<=0;end if;end if;if pop='1'and not empty then data_out<=fifo(head_ptr);head_ptr<=head_ptr+1;if head_ptr=8then head_ptr<=0;end if;end if;end if;end process;full<='1'when(tail_ptr=head_ptr+1or(head_ptr=0and tail_ptr=8))else'0';empty<='1'when(head_ptr=tail_ptr)else'0';end Behavioral;
entity toggle_ff is port(clk,in std_logic;reset_n,in std_logic;toggle,in std_logic;q,out std_logic);end entity toggle_ff;architecture Behavioral of toggle_ff is signal ff_state:std_logic:='0';begin process(clk,reset_n)begin if reset_n='0'then ff_state<='0';elsif rising_edge(clk)then if toggle='1'then ff_state<=not ff_state;end if;end if;end process;q<=ff_state;end architecture Behavioral;;
entity bcd_to_7seg_decoder is port(bcd_in:in std_logic_vector(3 downto 0);seg_out:out std_logic_vector(6 downto 0));architecture Behavioral of bcd_to_7seg_decoder is begin process(bcd_in) begin case bcd_in is when"0000"=>seg_out<="0000001";when"0001"=>seg_out<="1001111";when"0010"=>seg_out<="0010010";when"0011"=>seg_out<="0000110";when"0100"=>seg_out<="1001100";when"0101"=>seg_out<="0100100";when"0110"=>seg_out<="0100000";when"0111"=>seg_out<="0001111";when"1000"=>seg_out<="0000000";when"1001"=>seg_out<="0000100";when others=>seg_out<="1111111";end case;end process;end architecture Behavioral;
architecture Behavioral of single_clock_pulse_generator is begin process begin clk_pulse <= '1'; wait for 1 ns; clk_pulse <= '0'; wait; end process; end architecture Behavioral;
entity uart_transmitter is port(clk,in std_logic; reset: in std_logic; data: in std_logic_vector(7 downto 0); tx: out std_logic); architecture Behavioral of uart_transmitter is signal tx_reg:std_logic:='1';begin process(clk,reset)variable count:integer range 0 to 10:=0;begin if reset='1'then tx_reg:='1';count:=0;elsif rising_edge(clk)then if count=0 then tx<='0';count:=count+1;elsif count>=1 and count<=8 then tx<=data(count-1);count:=count+1;elsif count=9 then tx<='1';count:=count+1;else tx<='1';count:=0;end if;end if;end process;end architecture Behavioral;
entity parallel_in_parallel_out_shift_register is generic(N: integer := 8); port(clock: in std_logic; load_enable: in std_logic; shift_enable: in std_logic; shift_direction: in std_logic; data_in: in std_logic_vector(N-1 downto 0); data_out: out std_logic_vector(N-1 downto 0)); end entity parallel_in_parallel_out_shift_register; architecture Behavioral of parallel_in_parallel_out_shift_register is signal shift_reg: std_logic_vector(N-1 downto 0); begin process(clock) begin if rising_edge(clock) then if load_enable = '1' then shift_reg <= data_in; elsif shift_enable = '1' then if shift_direction = '0' then shift_reg(N-1 downto 1) <= shift_reg(N-2 downto 0); shift_reg(0) <= '0'; else shift_reg(1 to N-1) <= shift_reg(0 to N-2); shift_reg(0) <= '0'; end if; end if; end if; end process; data_out <= shift_reg; end architecture Behavioral;
entity parallel_to_serial_converter is generic(N: integer := 8); port(clock: in std_logic; parallel_in: in std_logic_vector(N-1 downto 0); load_enable: in std_logic; serial_out: out std_logic); end entity parallel_to_serial_converter; architecture Behavioral of parallel_to_serial_converter is signal shift_reg: std_logic_vector(N-1 downto 0); signal counter: integer range 0 to N-1 := 0; begin process(clock) begin if rising_edge(clock) then if load_enable = '1' then shift_reg <= parallel_in; counter <= 0; else if counter < N then serial_out <= shift_reg(counter); counter <= counter + 1; end if; end if; end if; end process; end architecture Behavioral;
